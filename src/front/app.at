// app.at — 014-weather 天气仪表盘（PLAN-660 r2）
//
// r1 → r2（用户反馈 2026-09-20）：
//   1. 优先适配网页/桌面横屏；竖屏布局保留为 layout_mode=="portrait" 分支
//      （未来手机版可直接切换/响应式扩展）。
//   2. 滚动一律改用 AutoUI `scroll`（别名 scrollable → Vue ScrollArea / VM
//      iced scrollable），不再手写 overflow-x-auto。
//
// 设计锚点：桌面天气仪表盘（横屏）+ Apple Weather 竖屏（保留）。
// 主题契约：dark_mode / accent_color（Plan 458），变量名勿改。
// 城市选择：pill 芯片（不用 select —— selectitem iced:none）。
// Hero 渐变：view 内按 condition 条件 class（勿把 Tailwind 串绑到 style:，
// 生成器会落到 :style 导致渐变失效）。
//
// r3：选中态（*_on）必须自带 hover 提亮。button 默认 variant 是
// `bg-muted … hover:bg-muted/70`（见 gen/.../button/index.ts）；若 active
// 样式只写 bg-primary 不写 hover，cn 合并后 hover 仍是 muted 底 +
// primary-foreground 字 → 选中项 hover 发白不可读。与未选中对称：
// off → hover:bg-secondary/80，on → hover:bg-primary/90。
//
// r7：界面塌缩修复——去掉 fit + lg:/max-w 系（iced 量测不稳，Plan 512）。
// 窗口用 pac 显式尺寸；外壳固定 Tailwind 刻度宽（w-96 系在 VM 可用）；
// Hero 用 w-64（无 lg: 前缀）；城市条不用 container（避免 max-w-7xl 注入）。

// r8：rust/a2r 轨不解析 stylekit 包导入（hint_text UndefinedVariable）。
// 本地 recipe，与 stylekit.styles.hint_text 字节等价。
style hint_text = "text-[10px] text-muted-foreground"
// r9：a2r 不把 `use weather_data: fn` 内联进 main.rs（E0425）。函数同文件
// 放在 widget 之后；城市选择用中文名字符串键，避免 Obj id 被推成 i62。
//
// PLAN-009：城市模型收敛——单一有序城市表（后端 cities.json 持久化，
// 位置 0 = 主城市带 ★），选中态统一 cur_id/cur_name/cur_lat/cur_lon，
// 取数统一 weather_report_at 坐标通道；启动偏好 startup(main/last) +
// last_id 选中记忆随 settings 5 字段落盘；内置 10 城 pill 展开与
// t_city_* ×10 删除。共享 fn 经 a2r 不进 main.rs（r9），重灌/选中记忆
// 逻辑在各 handler 内联等价展开（注释标 pick_city/reload 语义）。

style page = "w-full h-full bg-background text-foreground"
style app_frame = "w-full bg-card border border-border rounded-2xl p-4 gap-4 shadow-lg"
style city_pill_on = "px-3 py-1.5 rounded-full text-xs font-medium bg-primary text-primary-foreground hover:bg-primary/90 shadow-sm shrink-0 transition-colors"
style city_pill_off = "px-3 py-1.5 rounded-full text-xs font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 shrink-0 transition-colors"
style icon_btn = "w-9 h-9 items-center justify-center rounded-full bg-secondary text-secondary-foreground hover:bg-secondary/80 transition-colors"
style section_title = "text-sm font-semibold text-foreground"
style metric_card = "bg-card border border-border rounded-2xl p-3 gap-1 min-w-0 flex-1"
style metric_label = "text-[10px] text-muted-foreground uppercase tracking-wider"
style metric_value = "text-sm font-semibold text-foreground"
style hour_card_now = "w-16 shrink-0 items-center gap-1.5 py-3 rounded-2xl bg-primary/15 border border-primary/30"
style hour_card = "w-16 shrink-0 items-center gap-1.5 py-3 rounded-2xl bg-muted/50 border border-border/40"
style day_card_now = "w-16 shrink-0 items-center gap-0.5 py-2.5 rounded-2xl bg-primary/15 border border-primary/30"
style day_card = "w-16 shrink-0 items-center gap-0.5 py-2.5 rounded-2xl bg-muted/50 border border-border/40"
style forecast_card = "bg-muted/40 border border-border/60 rounded-2xl p-3 gap-2 w-full"
style fc_tab_on = "h-7 px-3 rounded-full text-xs font-medium bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
style fc_tab_off = "h-7 px-3 rounded-full text-xs font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 transition-colors"
style refresh_busy = "h-8 px-3 rounded-full text-xs font-medium bg-muted text-muted-foreground border border-border"
style refresh_idle = "h-8 px-3 rounded-full text-xs font-medium bg-primary text-primary-foreground hover:bg-primary/90 shadow-sm transition-colors"
style layout_btn_on = "h-7 px-2.5 rounded-full text-[11px] font-medium bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
style layout_btn_off = "h-7 px-2.5 rounded-full text-[11px] font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 transition-colors"
style aqi_good = "text-[10px] px-1.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-600 font-medium"
style aqi_warn = "text-[10px] px-1.5 py-0.5 rounded-full bg-amber-500/15 text-amber-600 font-medium"
style aqi_mid = "text-[10px] px-1.5 py-0.5 rounded-full bg-primary/15 text-primary font-medium"

// r10（v0.6-dev 真实数据）：后端代理 Open-Meteo。#[api] 调用在 VM merged
// 轨进程内执行；Vue 轨经生成客户端走 back_port 17817。后端不可达/失败时
// r.ok=false，全场保留下方演示样本（渐进降级，与 027-file-manager 同构）。
// PLAN-001：城市搜索/自定义城市/任意坐标报文（平行 str 数组 + 索引循环
// 物化——os-config VG12-14 终版 API 形状规则）。
use back.api: weather_search, cities_get, cities_add, cities_remove, weather_report_at, settings_get, settings_set, cities_move

// PLAN-007 i18n：lang 贯穿取数链；界面文案全量 t_* 变量化（见 model）

widget App {
    msg {
        SelectCity(str),
        Refresh,
        ToggleTheme,
        SetTheme(str),
        SetAccent(str),
        SetLayout(str),
        SetForecastTab(str),
        RemoveCity(str),
        ToggleSettings,
        SetTempUnit(str),
        SetWindUnit(str),
        CycleStartup,
        MoveCity(str, str),
        SetLang(str),
        Init
    }

    model {
        var dark_mode bool = true
        var accent_color str = "indigo"
        // landscape = 网页/桌面优先；portrait = 保留的手机版竖屏设计
        var layout_mode str = "landscape"
        // 预报区 Tab：hourly | daily（默认窗口不高，二者互斥显示）
        var forecast_tab str = "hourly"

        // PLAN-009：当前城市（取数唯一依据；全表统一走 weather_report_at
        // 坐标通道；cur_name 同时供 header 绑定，不随语言切换）
        var cur_id str = ""
        var cur_name str = "北京"
        var cur_lat str = "39.90"
        var cur_lon str = "116.40"
        // PLAN-009：主城市 = 列表首位 id（重灌时镜像；★ 判定依据）
        var main_id str = ""
        // PLAN-009：空表门控（删光城市 → 空态 hint、跳取数）
        var cities_empty bool = false
        var condition str = "partly"
        var cond_zh str = "多云"
        var icon str = "⛅"
        var temp str = "23°"
        var feels str = "25°"
        var humidity str = "65%"
        var wind str = "12 km/h"
        var uv str = "中等"
        var aqi str = "68"
        var aqi_level str = "良"
        var pressure str = "1012 hPa"
        var visibility str = "12 km"
        var updated_at str = "14:30"
        // r10：数据来源注记（实时成功 → Open-Meteo；失败保演示文案）
        var data_note str = "演示数据 · 非实时气象"
        var source_label str = "演示样本"
        // PLAN-001/009：搜索 + 唯一有序城市表——平行 str 数组（handler
        // 索引循环物化）+ 视图态 map 列表（view 端 for 渲染，VG4）
        var search_q str = ""
        var search_err str = ""
        var search_ids = []
        var search_names = []
        var search_subs = []
        var search_lats = []
        var search_lons = []
        var search_hits = []
        var city_ids = []
        var city_names = []
        var city_lats = []
        var city_lons = []
        // 元素 {id, disp}；disp 重灌时预拼（首位 "★ "+name 主城市徽记）
        var cities_pills = []
        // PLAN-002：空气组分 + 生活指数
        var pm25 str = "—"
        var pm10 str = "—"
        var o3 str = "—"
        var indices = []
        // PLAN-003：24h 降水 + 预警展示位（空串=无预警）
        var precip = []
        var alert_level str = ""
        var alert_title str = ""
        var alert_text str = ""
        // PLAN-006：设置中心
        var s_temp_unit str = "c"
        var s_wind_unit str = "kmh"
        // PLAN-009：启动偏好（main=主城市 / last=上次选中；设置卡互切）
        var s_startup str = "main"
        // PLAN-009：最近一次选中城市 id（pick_city 语义落盘；启动选路依据）
        var s_last_id str = ""
        // 启动偏好按钮 label（唯一可定位；视图 paren-expr 受限，handler 预拼）
        var s_startup_label str = "启动:主城市"
        var settings_open bool = false
        // PLAN-007：界面语言（zh/en；label 变量化后全面生效）
        var lang str = "zh"
        // PLAN-007：取数成功置真——语言切换时演示注记是否重刷的依据
        var live bool = false
        // PLAN-007 t_*：界面文案变量（zh 为模型默认；en 由 Init/SetLang
        // 大块赋值。r9：handler 不调用 helper，两语块内联两处）
        var t_layout_land str = "横屏"
        var t_layout_port str = "竖屏"
        var t_refresh str = "刷新"
        var t_refreshing str = "刷新中…"
        var t_search_ph str = "搜索城市（中文/拼音）"
        var t_search str = "搜索"
        var t_settings str = "设置"
        var t_temp_unit str = "温度单位"
        var t_wind_unit str = "风速单位"
        var t_tab_hourly str = "24小时"
        var t_tab_daily str = "5日"
        var t_details str = "当前详情"
        var t_indices str = "生活指数"
        var t_precip str = "24小时降水"
        var t_humidity str = "湿度"
        var t_wind str = "风速"
        var t_feels str = "体感"
        var t_uv str = "紫外线"
        var t_aqi_good str = "优"
        var t_aqi_bad str = "轻度污染"
        var t_visibility str = "能见度"
        var t_pressure str = "气压"
        var t_updated str = "更新"
        var t_data str = "数据"
        var t_now str = "现在"
        var t_today str = "今天"
        var t_lang_label str = "语言"
        // PLAN-009：空态 hint + 启动偏好按钮文案（城市名不再随语言翻译——
        // 统一取后端持久化名；主城市 ★ 徽记由重灌预拼进 disp）
        var t_cities_empty str = "搜索添加城市"
        var t_startup_main str = "启动:主城市"
        var t_startup_last str = "启动:上次选中"
        var t_data_note_demo str = "演示数据 · 非实时气象"
        var t_source_demo str = "演示样本"
        var t_live_pre str = "实时数据 · "
        var t_search_empty str = "无结果（或网络不可用）"
        var refreshing bool = false
        var hourly = [
            { time: .t_now, icon: "⛅", temp: "23°", now: true },
            { time: "15:00", icon: "⛅", temp: "24°", now: false },
            { time: "16:00", icon: "⛅", temp: "24°", now: false },
            { time: "17:00", icon: "☁️", temp: "23°", now: false },
            { time: "18:00", icon: "☁️", temp: "22°", now: false },
            { time: "19:00", icon: "☁️", temp: "21°", now: false },
            { time: "20:00", icon: "☁️", temp: "20°", now: false },
            { time: "21:00", icon: "⛅", temp: "20°", now: false }
        ]
        var daily = [
            { day: .t_today, icon: "⛅", cond: "多云", tmin: "18°", tmax: "25°" },
            { day: "周二", icon: "☀️", cond: "晴", tmin: "20°", tmax: "28°" },
            { day: "周三", icon: "☁️", cond: "阴", tmin: "16°", tmax: "22°" },
            { day: "周四", icon: "🌧️", cond: "小雨", tmin: "17°", tmax: "24°" },
            { day: "周五", icon: "⛅", cond: "多云", tmin: "19°", tmax: "27°" }
        ]
    }

    view {
        col {
            style: page
            col {
                style: "w-full p-3 gap-3 items-center"
                col {
                    style: app_frame

                // PLAN-003：天气预警 banner（alert_title 空串 = 不渲染；
                // 内容待 PLAN-005 QWeather 接入）
                if .alert_title != "" {
                    row {
                        style: "w-full items-center gap-2 px-3 py-2 rounded-2xl bg-amber-500/15 border border-amber-500/40"
                        text .alert_level { style: "text-xs font-bold text-amber-600 shrink-0" }
                        text .alert_title { style: "text-xs font-medium text-foreground" }
                    }
                }

                // ── Header ──
                row {
                    style: "w-full items-center gap-3"
                    col {
                        style: "gap-0.5 min-w-0"
                        // PLAN-009：城市名统一绑 cur_name（后端持久化名）
                        text .cur_name { style: "text-2xl lg:text-3xl font-bold text-foreground tracking-tight" }
                        if .lang == "en" {
                            text f"Updated ${.updated_at}" { style: hint_text }
                        } else {
                            text f"更新于 ${.updated_at}" { style: hint_text }
                        }
                    }
                    row {
                        style: "ml-auto items-center gap-2 shrink-0"
                        // 布局切换：横屏（默认）/ 竖屏（手机版预览）
                        row {
                            style: "items-center gap-1 mr-1"
                            if .layout_mode == "landscape" {
                                button .t_layout_land { onclick: .SetLayout("landscape"), variant: "primary", style: layout_btn_on }
                            } else {
                                button .t_layout_land { onclick: .SetLayout("landscape"), variant: "secondary", style: layout_btn_off }
                            }
                            if .layout_mode == "portrait" {
                                button .t_layout_port { onclick: .SetLayout("portrait"), variant: "primary", style: layout_btn_on }
                            } else {
                                button .t_layout_port { onclick: .SetLayout("portrait"), variant: "secondary", style: layout_btn_off }
                            }
                        }
                        // a2r：参数形按钮（子节点 text 会生成 button("")）
                        if .refreshing {
                            button .t_refreshing { onclick: .Refresh, variant: "primary", style: refresh_busy }
                        } else {
                            button .t_refresh { onclick: .Refresh, variant: "primary", style: refresh_idle }
                        }
                        if .dark_mode {
                            button "☀️" { onclick: .ToggleTheme, style: icon_btn }
                        } else {
                            button "🌙" { onclick: .ToggleTheme, style: icon_btn }
                        }
                        button "⚙️" { onclick: .ToggleSettings, style: icon_btn }
                    }
                }

                // ── PLAN-001/004：城市搜索（横屏；竖屏同块在 portrait 分支）──
                row {
                    style: "w-full items-center gap-2"
                    input { placeholder: .t_search_ph, value: .search_q, oninput: .SearchChanged, style: "flex-1 px-3 py-1.5 text-xs rounded-full border border-border bg-background text-foreground outline-none" }
                    button .t_search { onclick: .DoSearch, variant: "primary", style: refresh_idle }
                }
                if .search_err != "" {
                    text .search_err { style: hint_text }
                }
                // 搜索结果行（空列表 for 零迭代；点击添加为自定义城市）
                row {
                    style: "w-full gap-2 flex-wrap"
                    for h in .search_hits {
                        button h.label { onclick: .AddHit(h.id), variant: "secondary", style: city_pill_off }
                    }
                }

                // ── 城市 pill（不用 container，避免 max-w-7xl 注入）──
                col {
                    style: "w-full h-11 shrink-0"
                    scroll (axis: "x", style: "w-full h-full") {
                        row {
                            style: "items-center gap-2 h-full pr-2"
                            // PLAN-009：空表 hint（删光城市 → 引导搜索添加）
                            if .cities_empty {
                                text .t_cities_empty { style: hint_text }
                            }
                            // PLAN-009：唯一有序城市表 for 渲染（disp 重灌预拼：
                            // 首位带 ★ 主城市徽记）；选中高亮 = 双节点条件样式
                            for c in .cities_pills {
                                if c.id == .cur_id {
                                    button c.disp { onclick: .SelectCity(c.id), variant: "primary", style: city_pill_on }
                                } else {
                                    button c.disp { onclick: .SelectCity(c.id), variant: "secondary", style: city_pill_off }
                                }
                                button "✕" { onclick: .RemoveCity(c.id), variant: "secondary", style: "w-6 h-6 text-[10px] items-center justify-center rounded-full bg-secondary text-muted-foreground hover:bg-secondary/80 transition-colors shrink-0" }
                            }
                        }
                    }
                }

                // PLAN-006：设置中心（共享区，横竖屏皆可用；齿轮开合）
                if .settings_open {
                    col {
                        style: "w-full gap-2 bg-card border border-border rounded-2xl p-3"
                        text .t_settings { style: section_title }
                        row {
                            style: "w-full items-center gap-2"
                            text .t_temp_unit { style: "text-xs text-muted-foreground w-16 shrink-0" }
                            if .s_temp_unit == "c" {
                                button "°C" { onclick: .SetTempUnit("c"), variant: "primary", style: fc_tab_on }
                            } else {
                                button "°C" { onclick: .SetTempUnit("c"), variant: "secondary", style: fc_tab_off }
                            }
                            if .s_temp_unit == "f" {
                                button "°F" { onclick: .SetTempUnit("f"), variant: "primary", style: fc_tab_on }
                            } else {
                                button "°F" { onclick: .SetTempUnit("f"), variant: "secondary", style: fc_tab_off }
                            }
                        }
                        row {
                            style: "w-full items-center gap-2"
                            text .t_wind_unit { style: "text-xs text-muted-foreground w-16 shrink-0" }
                            if .s_wind_unit == "kmh" {
                                button "km/h" { onclick: .SetWindUnit("kmh"), variant: "primary", style: fc_tab_on }
                            } else {
                                button "km/h" { onclick: .SetWindUnit("kmh"), variant: "secondary", style: fc_tab_off }
                            }
                            if .s_wind_unit == "ms" {
                                button "m/s" { onclick: .SetWindUnit("ms"), variant: "primary", style: fc_tab_on }
                            } else {
                                button "m/s" { onclick: .SetWindUnit("ms"), variant: "secondary", style: fc_tab_off }
                            }
                        }
                        // PLAN-009：启动偏好行（main=主城市 / last=上次选中；互切落盘）
                        row {
                            style: "w-full items-center gap-2"
                            button .s_startup_label { onclick: .CycleStartup, variant: "secondary", style: fc_tab_off }
                        }
                        // PLAN-007：语言切换（zh/en；按钮文案保持自语言固定）
                        row {
                            style: "w-full items-center gap-2"
                            text .t_lang_label { style: "text-xs text-muted-foreground w-16 shrink-0" }
                            if .lang == "zh" {
                                button "中文" { onclick: .SetLang("zh"), variant: "primary", style: fc_tab_on }
                            } else {
                                button "中文" { onclick: .SetLang("zh"), variant: "secondary", style: fc_tab_off }
                            }
                            if .lang == "en" {
                                button "English" { onclick: .SetLang("en"), variant: "primary", style: fc_tab_on }
                            } else {
                                button "English" { onclick: .SetLang("en"), variant: "secondary", style: fc_tab_off }
                            }
                        }
                        // 城市管理：排序（↑↓）+ 删除（✕）；★ 行为主城市
                        for c in .cities_pills {
                            row {
                                style: "w-full items-center gap-2"
                                button c.disp { onclick: .SelectCity(c.id), variant: "secondary", style: "flex-1 justify-start px-3 py-1.5 text-xs rounded-full" }
                                button "↑" { onclick: .MoveCity(c.id, "up"), variant: "secondary", style: icon_btn }
                                button "↓" { onclick: .MoveCity(c.id, "down"), variant: "secondary", style: icon_btn }
                                button "✕" { onclick: .RemoveCity(c.id), variant: "secondary", style: icon_btn }
                            }
                        }
                    }
                }

                // ==================== 横屏布局（网页/桌面优先） ====================
                // r4：24h 上移到右栏顶部（桌面天气 App 常见信息架构）；
                // 小时卡有实体底色；scroll 直接包 row（去掉 container/多余 col，
                // 避免 max-w-7xl 注入与 ScrollArea 视口塌陷导致「只见 5 日」）。
                if .layout_mode == "landscape" {
                    col {
                        style: "w-full gap-3"

                        row {
                            style: "w-full gap-3 items-stretch"

                            // ── Hero（w-64，无 lg: 前缀，VM 可用）──
                            col {
                                style: if .condition == "sunny" {
                                    "w-64 shrink-0 bg-gradient-to-br from-amber-400 to-orange-500 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                } else if .condition == "rain" {
                                    "w-64 shrink-0 bg-gradient-to-br from-blue-400 to-blue-600 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                } else if .condition == "storm" {
                                    "w-64 shrink-0 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                } else if .condition == "snow" {
                                    "w-64 shrink-0 bg-gradient-to-br from-cyan-300 to-sky-500 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                } else if .condition == "fog" {
                                    "w-64 shrink-0 bg-gradient-to-br from-gray-300 to-slate-500 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                } else if .condition == "cloudy" {
                                    "w-64 shrink-0 bg-gradient-to-br from-slate-400 to-slate-600 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                } else {
                                    "w-64 shrink-0 bg-gradient-to-br from-sky-400 to-blue-500 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                }
                                text .icon { style: "text-5xl" }
                                text .cond_zh { style: "text-base font-medium text-white" }
                                text .temp { style: "text-6xl font-light text-white leading-none tracking-tight" }
                                row {
                                    style: "items-center gap-2 text-white/90 text-xs mt-1 flex-wrap justify-center"
                                    if .lang == "en" {
                                        text f"Feels like ${.feels}" {}
                                    } else {
                                        text f"体感 ${.feels}" {}
                                    }
                                    if .lang == "en" {
                                        text f"Humidity ${.humidity}" {}
                                    } else {
                                        text f"湿度 ${.humidity}" {}
                                    }
                                    if .lang == "en" {
                                        text f"Wind ${.wind}" {}
                                    } else {
                                        text f"风 ${.wind}" {}
                                    }
                                }
                            }

                            // ── 右栏：预报 Tab（24h/5日 互斥）→ 指标 ──
                            col {
                                style: "flex-1 min-w-0 gap-3"

                                // 预报卡：tab 切换，一次只显示一种
                                col {
                                    style: forecast_card
                                    row {
                                        style: "w-full items-center gap-2"
                                        if .forecast_tab == "hourly" {
                                            button .t_tab_hourly { onclick: .SetForecastTab("hourly"), variant: "primary", style: fc_tab_on }
                                        } else {
                                            button .t_tab_hourly { onclick: .SetForecastTab("hourly"), variant: "secondary", style: fc_tab_off }
                                        }
                                        if .forecast_tab == "daily" {
                                            button .t_tab_daily { onclick: .SetForecastTab("daily"), variant: "primary", style: fc_tab_on }
                                        } else {
                                            button .t_tab_daily { onclick: .SetForecastTab("daily"), variant: "secondary", style: fc_tab_off }
                                        }
                                    }

                                    if .forecast_tab == "hourly" {
                                        scroll (axis: "x", style: "w-full h-36") {
                                            row {
                                                style: "items-center gap-2 h-36"
                                                for h in .hourly {
                                                    if h.time == .t_now {
                                                        col {
                                                            style: hour_card_now
                                                            text h.time { style: "text-[10px] font-semibold text-primary" }
                                                            text h.icon { style: "text-lg" }
                                                            text h.temp { style: "text-sm font-bold text-primary" }
                                                        }
                                                    } else {
                                                        col {
                                                            style: hour_card
                                                            text h.time { style: "text-[10px] text-muted-foreground" }
                                                            text h.icon { style: "text-lg" }
                                                            text h.temp { style: "text-sm font-semibold text-foreground" }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if .forecast_tab == "daily" {
                                        // 与小时卡同构；温度两行：最高 / 最低
                                        scroll (axis: "x", style: "w-full h-36") {
                                            row {
                                                style: "items-center gap-2 h-36"
                                                for d in .daily {
                                                    if d.day == .t_today {
                                                        col {
                                                            style: day_card_now
                                                            text d.day { style: "text-[10px] font-semibold text-primary" }
                                                            text d.icon { style: "text-lg" }
                                                            text d.tmax { style: "text-sm font-bold text-primary" }
                                                            text d.tmin { style: "text-[10px] text-primary/70" }
                                                        }
                                                    } else {
                                                        col {
                                                            style: day_card
                                                            text d.day { style: "text-[10px] text-muted-foreground" }
                                                            text d.icon { style: "text-lg" }
                                                            text d.tmax { style: "text-sm font-semibold text-foreground" }
                                                            text d.tmin { style: "text-[10px] text-muted-foreground" }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // 当前详情
                                col {
                                    style: "w-full gap-2"
                                    text .t_details { style: section_title }
                                    row {
                                        style: "w-full gap-2"
                                        col {
                                            style: metric_card
                                            text .t_humidity { style: metric_label }
                                            text .humidity { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            text .t_wind { style: metric_label }
                                            text .wind { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            text .t_feels { style: metric_label }
                                            text .feels { style: metric_value }
                                        }
                                    }
                                    row {
                                        style: "w-full gap-2"
                                        col {
                                            style: metric_card
                                            text .t_uv { style: metric_label }
                                            text .uv { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            row {
                                                style: "items-center gap-1"
                                                text "AQI" { style: metric_label }
                                                if .aqi_level == .t_aqi_good {
                                                    text .aqi_level { style: aqi_good }
                                                } else if .aqi_level == .t_aqi_bad {
                                                    text .aqi_level { style: aqi_warn }
                                                } else {
                                                    text .aqi_level { style: aqi_mid }
                                                }
                                            }
                                            text .aqi { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            text .t_visibility { style: metric_label }
                                            text .visibility { style: metric_value }
                                        }
                                    }
                                    row {
                                        style: "w-full gap-2"
                                        col {
                                            style: metric_card
                                            text .t_pressure { style: metric_label }
                                            text .pressure { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            text .t_updated { style: metric_label }
                                            text .updated_at { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            text .t_data { style: metric_label }
                                            text .source_label { style: "text-xs text-muted-foreground" }
                                        }
                                    }
                                    // PLAN-002：空气组分（PM 行）
                                    row {
                                        style: "w-full gap-2"
                                        col {
                                            style: metric_card
                                            text "PM2.5" { style: metric_label }
                                            text .pm25 { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            text "PM10" { style: metric_label }
                                            text .pm10 { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            text "O3" { style: metric_label }
                                            text .o3 { style: metric_value }
                                        }
                                    }
                                }
                                // PLAN-002：生活指数区（for 零迭代安全）
                                col {
                                    style: "w-full gap-2"
                                    text .t_indices { style: section_title }
                                    row {
                                        style: "w-full gap-2"
                                        for it in .indices {
                                            col {
                                                style: "bg-card border border-border rounded-2xl p-3 gap-1 min-w-0 flex-1 items-center"
                                                text it.name { style: "text-[10px] text-muted-foreground" }
                                                text it.level { style: "text-sm font-semibold text-foreground" }
                                                text it.note { style: "text-[9px] text-muted-foreground text-center" }
                                            }
                                        }
                                    }
                                }
                                // PLAN-003：24小时降水（bar class 后端预拼）
                                col {
                                    style: "w-full gap-2"
                                    text .t_precip { style: section_title }
                                    scroll (axis: "x", style: "w-full h-28") {
                                        row {
                                            style: "items-end gap-1.5 h-24"
                                            for p in .precip {
                                                col {
                                                    style: "w-10 shrink-0 items-center gap-0.5"
                                                    text p.prob { style: "text-[9px] text-muted-foreground" }
                                                    col {
                                                        style: p.bar
                                                    }
                                                    text p.time { style: "text-[9px] text-muted-foreground" }
                                                    text p.amount { style: "text-[8px] text-muted-foreground/70" }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        text .data_note { style: "text-center text-[10px] text-muted-foreground/70" }

                        style: "w-full gap-3"
                    }
                }

                // ==================== 竖屏布局（保留：未来手机版） ====================
                if .layout_mode == "portrait" {
                    scroll (axis: "y", style: "w-full max-h-[520px]") {
                        col {
                            style: "w-full max-w-md mx-auto gap-3"

                            // Hero
                            col {
                                style: if .condition == "sunny" {
                                    "bg-gradient-to-br from-amber-400 to-orange-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "rain" {
                                    "bg-gradient-to-br from-blue-400 to-blue-600 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "storm" {
                                    "bg-gradient-to-br from-indigo-500 to-purple-600 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "snow" {
                                    "bg-gradient-to-br from-cyan-300 to-sky-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "fog" {
                                    "bg-gradient-to-br from-gray-300 to-slate-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "cloudy" {
                                    "bg-gradient-to-br from-slate-400 to-slate-600 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else {
                                    "bg-gradient-to-br from-sky-400 to-blue-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                }
                                text .icon { style: "text-5xl" }
                                text .cond_zh { style: "text-base font-medium text-white" }
                                text .temp { style: "text-7xl font-light text-white leading-none tracking-tight" }
                                row {
                                    style: "items-center gap-3 text-white/90 text-xs mt-1"
                                    if .lang == "en" {
                                        text f"Feels like ${.feels}" {}
                                    } else {
                                        text f"体感 ${.feels}" {}
                                    }
                                    if .lang == "en" {
                                        text f"Humidity ${.humidity}" {}
                                    } else {
                                        text f"湿度 ${.humidity}" {}
                                    }
                                    if .lang == "en" {
                                        text f"Wind ${.wind}" {}
                                    } else {
                                        text f"风 ${.wind}" {}
                                    }
                                }
                            }

                            // 指标
                            col {
                                style: "w-full gap-2"
                                text .t_details { style: section_title }
                                row {
                                    style: "w-full gap-2"
                                    col {
                                        style: metric_card
                                        text .t_humidity { style: metric_label }
                                        text .humidity { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text .t_wind { style: metric_label }
                                        text .wind { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text .t_feels { style: metric_label }
                                        text .feels { style: metric_value }
                                    }
                                }
                                row {
                                    style: "w-full gap-2"
                                    col {
                                        style: metric_card
                                        text .t_uv { style: metric_label }
                                        text .uv { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        row {
                                            style: "items-center gap-1"
                                            text "AQI" { style: metric_label }
                                            if .aqi_level == .t_aqi_good {
                                                text .aqi_level { style: aqi_good }
                                            } else if .aqi_level == .t_aqi_bad {
                                                text .aqi_level { style: aqi_warn }
                                            } else {
                                                text .aqi_level { style: aqi_mid }
                                            }
                                        }
                                        text .aqi { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text .t_visibility { style: metric_label }
                                        text .visibility { style: metric_value }
                                    }
                                }
                                row {
                                    style: "w-full gap-2"
                                    col {
                                        style: metric_card
                                        text .t_pressure { style: metric_label }
                                        text .pressure { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text .t_updated { style: metric_label }
                                        text .updated_at { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text .t_data { style: metric_label }
                                        text .source_label { style: "text-xs text-muted-foreground" }
                                    }
                                }
                                // PLAN-004：PM 行（竖屏对齐）
                                row {
                                    style: "w-full gap-2"
                                    col {
                                        style: metric_card
                                        text "PM2.5" { style: metric_label }
                                        text .pm25 { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "PM10" { style: metric_label }
                                        text .pm10 { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "O3" { style: metric_label }
                                        text .o3 { style: metric_value }
                                    }
                                }
                            }

                            // 预报 Tab（与横屏同构）
                            col {
                                style: forecast_card
                                row {
                                    style: "w-full items-center gap-2"
                                    if .forecast_tab == "hourly" {
                                        button .t_tab_hourly { onclick: .SetForecastTab("hourly"), variant: "primary", style: fc_tab_on }
                                    } else {
                                        button .t_tab_hourly { onclick: .SetForecastTab("hourly"), variant: "secondary", style: fc_tab_off }
                                    }
                                    if .forecast_tab == "daily" {
                                        button .t_tab_daily { onclick: .SetForecastTab("daily"), variant: "primary", style: fc_tab_on }
                                    } else {
                                        button .t_tab_daily { onclick: .SetForecastTab("daily"), variant: "secondary", style: fc_tab_off }
                                    }
                                }
                                if .forecast_tab == "hourly" {
                                    scroll (axis: "x", style: "w-full h-36") {
                                        row {
                                            style: "items-center gap-2 h-36"
                            for h in .hourly {
                                if h.time == .t_now {
                                    col {
                                        style: hour_card_now
                                        text h.time { style: "text-[10px] font-semibold text-primary" }
                                        text h.icon { style: "text-lg" }
                                        text h.temp { style: "text-sm font-bold text-primary" }
                                    }
                                } else {
                                    col {
                                        style: hour_card
                                        text h.time { style: "text-[10px] text-muted-foreground" }
                                        text h.icon { style: "text-lg" }
                                        text h.temp { style: "text-sm font-semibold text-foreground" }
                                    }
                                }
                            }
                                        }
                                    }
                                }
                                if .forecast_tab == "daily" {
                                    scroll (axis: "x", style: "w-full h-36") {
                                        row {
                                            style: "items-center gap-2 h-36"
                                            for d in .daily {
                                                if d.day == .t_today {
                                                    col {
                                                        style: day_card_now
                                                        text d.day { style: "text-[10px] font-semibold text-primary" }
                                                        text d.icon { style: "text-lg" }
                                                        text d.tmax { style: "text-sm font-bold text-primary" }
                                                        text d.tmin { style: "text-[10px] text-primary/70" }
                                                    }
                                                } else {
                                                    col {
                                                        style: day_card
                                                        text d.day { style: "text-[10px] text-muted-foreground" }
                                                        text d.icon { style: "text-lg" }
                                                        text d.tmax { style: "text-sm font-semibold text-foreground" }
                                                        text d.tmin { style: "text-[10px] text-muted-foreground" }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // PLAN-004：生活指数（竖屏 scroll-x 版；flex-wrap
                            // iced 不支持——plan412 降级矩阵在册）
                            col {
                                style: "w-full gap-2"
                                text .t_indices { style: section_title }
                                scroll (axis: "x", style: "w-full h-24") {
                                    row {
                                        style: "items-center gap-2 h-20"
                                        for it in .indices {
                                            col {
                                                style: "w-20 shrink-0 bg-card border border-border rounded-2xl p-3 gap-1 items-center"
                                                text it.name { style: "text-[10px] text-muted-foreground" }
                                                text it.level { style: "text-sm font-semibold text-foreground" }
                                                text it.note { style: "text-[9px] text-muted-foreground text-center" }
                                            }
                                        }
                                    }
                                }
                            }
                            // PLAN-004：24小时降水（竖屏）
                            col {
                                style: "w-full gap-2"
                                text .t_precip { style: section_title }
                                scroll (axis: "x", style: "w-full h-28") {
                                    row {
                                        style: "items-end gap-1.5 h-24"
                                        for p in .precip {
                                            col {
                                                style: "w-10 shrink-0 items-center gap-0.5"
                                                text p.prob { style: "text-[9px] text-muted-foreground" }
                                                col {
                                                    style: p.bar
                                                }
                                                text p.time { style: "text-[9px] text-muted-foreground" }
                                                text p.amount { style: "text-[8px] text-muted-foreground/70" }
                                            }
                                        }
                                    }
                                }
                            }

                            text .data_note { style: "text-center text-[10px] text-muted-foreground/70" }

                            style: "w-full max-w-md mx-auto gap-3"
                        }
                    }
                }

                    style: app_frame
                }
                style: "w-full p-3 gap-3 items-center"
            }
            style: page
        }
    }

    on {
        // r9：a2r 不发射 app.at 顶层 fn 进 main.rs（E0425），handler 一律
        // 字面量 if/else 赋值，不调用 helper（PLAN-009 的 pick_city/reload
        // 语义在各 handler 内联等价展开）。
        .Init -> {
            .layout_mode = "landscape"
            .forecast_tab = "hourly"
            // PLAN-009：先取设置（5 字段单位/语言/启动偏好/选中记忆），失败保默认
            let rs = settings_get()
            if rs.ok {
                .s_temp_unit = rs.temp_unit
                .s_wind_unit = rs.wind_unit
                .lang = rs.lang
                .s_startup = rs.startup
                .s_last_id = rs.last_id
            }
            // PLAN-007：持久化 lang=en → t_* 全量切英（zh 侧保持模型默认，
            // 无需 else 块）
            if .lang == "en" {
                .t_layout_land = "Landscape"
                .t_layout_port = "Portrait"
                .t_refresh = "Refresh"
                .t_refreshing = "Refreshing…"
                .t_search_ph = "Search city (中文/拼音)"
                .t_search = "Search"
                .t_settings = "Settings"
                .t_temp_unit = "Temp unit"
                .t_wind_unit = "Wind unit"
                .t_tab_hourly = "24H"
                .t_tab_daily = "5-Day"
                .t_details = "Details"
                .t_indices = "Life Indices"
                .t_precip = "24H Precip"
                .t_humidity = "Humidity"
                .t_wind = "Wind"
                .t_feels = "Feels like"
                .t_uv = "UV"
                .t_aqi_good = "Good"
                .t_aqi_bad = "Unhealthy for Sensitive"
                .t_visibility = "Visibility"
                .t_pressure = "Pressure"
                .t_updated = "Updated"
                .t_data = "Source"
                .t_now = "Now"
                .t_today = "Today"
                .t_lang_label = "Language"
                .t_cities_empty = "Search to add a city"
                .t_startup_main = "Startup: Main city"
                .t_startup_last = "Startup: Last selected"
                .t_data_note_demo = "Demo data · Not live weather"
                .t_source_demo = "Demo data"
                .t_live_pre = "Live · "
                .t_search_empty = "No results (or network unavailable)"
            }
            // PLAN-009：启动偏好按钮 label 预拼（随语言）
            if .s_startup == "last" {
                .s_startup_label = .t_startup_last
            } else {
                .s_startup_label = .t_startup_main
            }
            .condition = "partly"
            .cond_zh = "多云"
            .icon = "⛅"
            .temp = "23°"
            .feels = "25°"
            .humidity = "65%"
            .wind = "12 km/h"
            .uv = "中等"
            .aqi = "68"
            .aqi_level = "良"
            .pressure = "1012 hPa"
            .visibility = "12 km"
            .hourly = [
                { time: .t_now, icon: "⛅", temp: "23°", now: true },
                { time: "15:00", icon: "⛅", temp: "23°", now: false },
                { time: "16:00", icon: "⛅", temp: "23°", now: false },
                { time: "17:00", icon: "☁️", temp: "23°", now: false },
                { time: "18:00", icon: "☁️", temp: "23°", now: false },
                { time: "19:00", icon: "☁️", temp: "23°", now: false },
                { time: "20:00", icon: "☁️", temp: "23°", now: false },
                { time: "21:00", icon: "⛅", temp: "23°", now: false }
            ]
            .daily = [
                { day: .t_today, icon: "⛅", cond: "多云", tmin: "18°", tmax: "25°" },
                { day: "周二", icon: "☀️", cond: "晴", tmin: "20°", tmax: "28°" },
                { day: "周三", icon: "☁️", cond: "阴", tmin: "16°", tmax: "22°" },
                { day: "周四", icon: "🌧️", cond: "小雨", tmin: "17°", tmax: "24°" },
                { day: "周五", icon: "⛅", cond: "多云", tmin: "19°", tmax: "27°" }
            ]
            .updated_at = "14:30"
            // PLAN-009：唯一有序城市表（后端持久化；读路径缺文件合成北京种子；
            // 空表=删光，合法持久态）。物化平行数组 + pill 列表（disp 预拼：
            // 首位带 ★ 主城市徽记）。失败按空表处理（空态 hint、跳取数）
            let rc = cities_get()
            if rc.ok {
                var k int = 0
                for x in rc.ids {
                    .city_ids.push(rc.ids.get(k))
                    .city_names.push(rc.names.get(k))
                    .city_lats.push(rc.lats.get(k))
                    .city_lons.push(rc.lons.get(k))
                    if k == 0 {
                        .cities_pills.push({ id: rc.ids.get(k), disp: "★ " + rc.names.get(k) })
                    } else {
                        .cities_pills.push({ id: rc.ids.get(k), disp: rc.names.get(k) })
                    }
                    k = k + 1
                }
            }
            if .city_ids.len() == 0 {
                // 空表：空态 hint、跳取数（保演示样本 + demo 注记，不闪错）
                .cities_empty = true
                .main_id = ""
                .data_note = .t_data_note_demo
                .source_label = .t_source_demo
            } else {
                .cities_empty = false
                .main_id = .city_ids.get(0)
                // 选启动城市：startup=last 且 last_id 在表 → 该城；否则首位。
                // 启动选路不走 pick_city、不落盘（避免每次启动写文件）
                var pick int = 0
                if .s_startup == "last" {
                    var s int = 0
                    while s < .city_ids.len() {
                        if .city_ids.get(s) == .s_last_id {
                            pick = s
                        }
                        s = s + 1
                    }
                }
                .cur_id = .city_ids.get(pick)
                .cur_name = .city_names.get(pick)
                .cur_lat = .city_lats.get(pick)
                .cur_lon = .city_lons.get(pick)
                // r10：起屏拉一次真实数据；失败静默保留上方演示样本
                let r = weather_report_at(.cur_lat, .cur_lon, .s_temp_unit, .s_wind_unit, .lang)
                if r.ok {
                    .live = true
                    .condition = r.condition
                    .cond_zh = r.cond_zh
                    .icon = r.icon
                    .temp = r.temp
                    .feels = r.feels
                    .humidity = r.humidity
                    .wind = r.wind
                    .uv = r.uv
                    .aqi = r.aqi
                    .aqi_level = r.aqi_level
                    .pressure = r.pressure
                    .visibility = r.visibility
                    .updated_at = r.updated_at
                    .hourly = r.hourly
                    .daily = r.daily
                    .data_note = .t_live_pre + r.source
                    .source_label = r.source
                    .pm25 = r.pm25
                    .pm10 = r.pm10
                    .o3 = r.o3
                    .indices = r.indices
                    .precip = r.precip
                    .alert_level = r.alert_level
                    .alert_title = r.alert_title
                    .alert_text = r.alert_text
                }
                if !r.ok {
                    // 演示态：注记随语言（live=false，切语言时同样重刷）
                    .data_note = .t_data_note_demo
                    .source_label = .t_source_demo
                }
            }
        }

        // PLAN-001：搜索输入（单参直发，os-config e2e 规则）
        .SearchChanged(q) -> {
            .search_q = q
        }

        // PLAN-001：执行搜索——平行 str 数组物化为视图态列表
        .DoSearch -> {
            .search_err = ""
            .search_hits = []
            .search_ids = []
            .search_names = []
            .search_subs = []
            .search_lats = []
            .search_lons = []
            let r = weather_search(.search_q, .lang)
            if r.ok {
                var i int = 0
                for x in r.ids {
                    .search_ids.push(r.ids.get(i))
                    .search_names.push(r.names.get(i))
                    .search_subs.push(r.subs.get(i))
                    .search_lats.push(r.lats.get(i))
                    .search_lons.push(r.lons.get(i))
                    .search_hits.push({ id: r.ids.get(i), name: r.names.get(i), sub: r.subs.get(i), label: r.names.get(i) + " · " + r.subs.get(i) })
                    i = i + 1
                }
            }
            if .search_hits.len() == 0 {
                .search_err = .t_search_empty
            }
        }

        // PLAN-001/009：添加搜索结果进唯一有序表（索引循环定位，handler
        // 不读循环变量 map——VG4；cities_add 返回新表即重灌）。此前空表
        // → pick_city(0) 语义：自动选中首城 + last_id 记忆落盘 + 取数
        .AddHit(id) -> {
            .search_err = ""
            var i int = 0
            var found bool = false
            var nm str = ""
            var la str = ""
            var lo str = ""
            while i < .search_ids.len() {
                if .search_ids.get(i) == id {
                    found = true
                    nm = .search_names.get(i)
                    la = .search_lats.get(i)
                    lo = .search_lons.get(i)
                }
                i = i + 1
            }
            if found {
                var was_empty bool = false
                if .city_ids.len() == 0 {
                    was_empty = true
                }
                let r2 = cities_add(id, nm, la, lo)
                if r2.ok {
                    .city_ids = []
                    .city_names = []
                    .city_lats = []
                    .city_lons = []
                    .cities_pills = []
                    var j int = 0
                    for x in r2.ids {
                        .city_ids.push(r2.ids.get(j))
                        .city_names.push(r2.names.get(j))
                        .city_lats.push(r2.lats.get(j))
                        .city_lons.push(r2.lons.get(j))
                        if j == 0 {
                            .cities_pills.push({ id: r2.ids.get(j), disp: "★ " + r2.names.get(j) })
                        } else {
                            .cities_pills.push({ id: r2.ids.get(j), disp: r2.names.get(j) })
                        }
                        j = j + 1
                    }
                    if .city_ids.len() == 0 {
                        .cities_empty = true
                        .main_id = ""
                    } else {
                        .cities_empty = false
                        .main_id = .city_ids.get(0)
                    }
                    .search_hits = []
                    .search_q = ""
                    if was_empty {
                        // pick_city(0)：cur_* + last_id 记忆 + settings 落盘
                        .cur_id = .city_ids.get(0)
                        .cur_name = .city_names.get(0)
                        .cur_lat = .city_lats.get(0)
                        .cur_lon = .city_lons.get(0)
                        .s_last_id = .city_ids.get(0)
                        settings_set(.s_temp_unit, .s_wind_unit, .lang, .s_startup, .s_last_id)
                        let r = weather_report_at(.cur_lat, .cur_lon, .s_temp_unit, .s_wind_unit, .lang)
                        if r.ok {
                            .live = true
                            .condition = r.condition
                            .cond_zh = r.cond_zh
                            .icon = r.icon
                            .temp = r.temp
                            .feels = r.feels
                            .humidity = r.humidity
                            .wind = r.wind
                            .uv = r.uv
                            .aqi = r.aqi
                            .aqi_level = r.aqi_level
                            .pressure = r.pressure
                            .visibility = r.visibility
                            .updated_at = r.updated_at
                            .hourly = r.hourly
                            .daily = r.daily
                            .data_note = .t_live_pre + r.source
                            .source_label = r.source
                            .pm25 = r.pm25
                            .pm10 = r.pm10
                            .o3 = r.o3
                            .indices = r.indices
                            .precip = r.precip
                            .alert_level = r.alert_level
                            .alert_title = r.alert_title
                            .alert_text = r.alert_text
                        }
                    }
                }
            }
        }

        // PLAN-009：选中城市（list 内任一 pill / 设置卡城市行共用）——
        // 索引循环定位 → pick_city 语义：存 cur_*（含坐标）+ s_last_id
        // 记忆 + settings_set 5 参落盘 → report_at 取数（失败保留现状）
        .SelectCity(id) -> {
            .search_err = ""
            var i int = 0
            var found bool = false
            var nm str = ""
            var la str = ""
            var lo str = ""
            while i < .city_ids.len() {
                if .city_ids.get(i) == id {
                    found = true
                    nm = .city_names.get(i)
                    la = .city_lats.get(i)
                    lo = .city_lons.get(i)
                }
                i = i + 1
            }
            if found {
                .cur_id = id
                .cur_name = nm
                .cur_lat = la
                .cur_lon = lo
                .s_last_id = id
                settings_set(.s_temp_unit, .s_wind_unit, .lang, .s_startup, .s_last_id)
                let r = weather_report_at(la, lo, .s_temp_unit, .s_wind_unit, .lang)
                if r.ok {
                    .live = true
                    .condition = r.condition
                    .cond_zh = r.cond_zh
                    .icon = r.icon
                    .temp = r.temp
                    .feels = r.feels
                    .humidity = r.humidity
                    .wind = r.wind
                    .uv = r.uv
                    .aqi = r.aqi
                    .aqi_level = r.aqi_level
                    .pressure = r.pressure
                    .visibility = r.visibility
                    .updated_at = r.updated_at
                    .hourly = r.hourly
                    .daily = r.daily
                    .data_note = .t_live_pre + r.source
                    .source_label = r.source
                    .pm25 = r.pm25
                    .pm10 = r.pm10
                    .o3 = r.o3
                    .indices = r.indices
                    .precip = r.precip
                    .alert_level = r.alert_level
                    .alert_title = r.alert_title
                    .alert_text = r.alert_text
                }
            }
        }

        // PLAN-009：删除城市——remove → 重灌（★ 与 main_id 随重灌更新）；
        // 删的是当前城市 → 空表则空态跳取数 + 清 last_id 落盘，非空则
        // pick_city(0) 语义回落首城（记忆落盘 + 取数）；未选中不动
        .RemoveCity(id) -> {
            let r3 = cities_remove(id)
            if r3.ok {
                var was_cur bool = false
                if .cur_id == id {
                    was_cur = true
                }
                .city_ids = []
                .city_names = []
                .city_lats = []
                .city_lons = []
                .cities_pills = []
                var j int = 0
                for x in r3.ids {
                    .city_ids.push(r3.ids.get(j))
                    .city_names.push(r3.names.get(j))
                    .city_lats.push(r3.lats.get(j))
                    .city_lons.push(r3.lons.get(j))
                    if j == 0 {
                        .cities_pills.push({ id: r3.ids.get(j), disp: "★ " + r3.names.get(j) })
                    } else {
                        .cities_pills.push({ id: r3.ids.get(j), disp: r3.names.get(j) })
                    }
                    j = j + 1
                }
                if .city_ids.len() == 0 {
                    .cities_empty = true
                    .main_id = ""
                    .s_last_id = ""
                    settings_set(.s_temp_unit, .s_wind_unit, .lang, .s_startup, .s_last_id)
                } else {
                    .cities_empty = false
                    .main_id = .city_ids.get(0)
                    if was_cur {
                        // pick_city(0)：回落首城 + 记忆 + 落盘 + 取数
                        .cur_id = .city_ids.get(0)
                        .cur_name = .city_names.get(0)
                        .cur_lat = .city_lats.get(0)
                        .cur_lon = .city_lons.get(0)
                        .s_last_id = .city_ids.get(0)
                        settings_set(.s_temp_unit, .s_wind_unit, .lang, .s_startup, .s_last_id)
                        let r = weather_report_at(.cur_lat, .cur_lon, .s_temp_unit, .s_wind_unit, .lang)
                        if r.ok {
                            .live = true
                            .condition = r.condition
                            .cond_zh = r.cond_zh
                            .icon = r.icon
                            .temp = r.temp
                            .feels = r.feels
                            .humidity = r.humidity
                            .wind = r.wind
                            .uv = r.uv
                            .aqi = r.aqi
                            .aqi_level = r.aqi_level
                            .pressure = r.pressure
                            .visibility = r.visibility
                            .updated_at = r.updated_at
                            .hourly = r.hourly
                            .daily = r.daily
                            .data_note = .t_live_pre + r.source
                            .source_label = r.source
                            .pm25 = r.pm25
                            .pm10 = r.pm10
                            .o3 = r.o3
                            .indices = r.indices
                            .precip = r.precip
                            .alert_level = r.alert_level
                            .alert_title = r.alert_title
                            .alert_text = r.alert_text
                        }
                    }
                }
            }
        }

        // PLAN-006：设置中心 handler
        .ToggleSettings -> {
            .settings_open = !.settings_open
        }

        .SetTempUnit(u) -> {
            .s_temp_unit = u
            settings_set(.s_temp_unit, .s_wind_unit, .lang, .s_startup, .s_last_id)
        }

        .SetWindUnit(u) -> {
            .s_wind_unit = u
            settings_set(.s_temp_unit, .s_wind_unit, .lang, .s_startup, .s_last_id)
        }

        // PLAN-009：启动偏好互切（main↔last）→ 重拼 label → settings 落盘
        .CycleStartup -> {
            if .s_startup == "main" {
                .s_startup = "last"
                .s_startup_label = .t_startup_last
            } else {
                .s_startup = "main"
                .s_startup_label = .t_startup_main
            }
            settings_set(.s_temp_unit, .s_wind_unit, .lang, .s_startup, .s_last_id)
        }

        // PLAN-007：语言切换——t_* 全量赋值 + 持久化；数据面语言下次取数生效
        // （界面即时）。演示态注记随语言重刷（live 守门）。
        .SetLang(l) -> {
            .lang = l
            if .lang == "en" {
                .t_layout_land = "Landscape"
                .t_layout_port = "Portrait"
                .t_refresh = "Refresh"
                .t_refreshing = "Refreshing…"
                .t_search_ph = "Search city (中文/拼音)"
                .t_search = "Search"
                .t_settings = "Settings"
                .t_temp_unit = "Temp unit"
                .t_wind_unit = "Wind unit"
                .t_tab_hourly = "24H"
                .t_tab_daily = "5-Day"
                .t_details = "Details"
                .t_indices = "Life Indices"
                .t_precip = "24H Precip"
                .t_humidity = "Humidity"
                .t_wind = "Wind"
                .t_feels = "Feels like"
                .t_uv = "UV"
                .t_aqi_good = "Good"
                .t_aqi_bad = "Unhealthy for Sensitive"
                .t_visibility = "Visibility"
                .t_pressure = "Pressure"
                .t_updated = "Updated"
                .t_data = "Source"
                .t_now = "Now"
                .t_today = "Today"
                .t_lang_label = "Language"
                .t_cities_empty = "Search to add a city"
                .t_startup_main = "Startup: Main city"
                .t_startup_last = "Startup: Last selected"
                .t_data_note_demo = "Demo data · Not live weather"
                .t_source_demo = "Demo data"
                .t_live_pre = "Live · "
                .t_search_empty = "No results (or network unavailable)"
            } else {
                .t_layout_land = "横屏"
                .t_layout_port = "竖屏"
                .t_refresh = "刷新"
                .t_refreshing = "刷新中…"
                .t_search_ph = "搜索城市（中文/拼音）"
                .t_search = "搜索"
                .t_settings = "设置"
                .t_temp_unit = "温度单位"
                .t_wind_unit = "风速单位"
                .t_tab_hourly = "24小时"
                .t_tab_daily = "5日"
                .t_details = "当前详情"
                .t_indices = "生活指数"
                .t_precip = "24小时降水"
                .t_humidity = "湿度"
                .t_wind = "风速"
                .t_feels = "体感"
                .t_uv = "紫外线"
                .t_aqi_good = "优"
                .t_aqi_bad = "轻度污染"
                .t_visibility = "能见度"
                .t_pressure = "气压"
                .t_updated = "更新"
                .t_data = "数据"
                .t_now = "现在"
                .t_today = "今天"
                .t_lang_label = "语言"
                .t_cities_empty = "搜索添加城市"
                .t_startup_main = "启动:主城市"
                .t_startup_last = "启动:上次选中"
                .t_data_note_demo = "演示数据 · 非实时气象"
                .t_source_demo = "演示样本"
                .t_live_pre = "实时数据 · "
                .t_search_empty = "无结果（或网络不可用）"
            }
            // PLAN-009：启动偏好 label 随语言重拼
            if .s_startup == "last" {
                .s_startup_label = .t_startup_last
            } else {
                .s_startup_label = .t_startup_main
            }
            if !.live {
                .data_note = .t_data_note_demo
                .source_label = .t_source_demo
            }
            settings_set(.s_temp_unit, .s_wind_unit, .lang, .s_startup, .s_last_id)
        }

        // PLAN-009：排序——move → 重灌（★ 与 main_id 随重灌更新）；当前
        // 选中不因移动而改选、不触发取数
        .MoveCity(id, dir) -> {
            let rm = cities_move(id, dir)
            if rm.ok {
                .city_ids = []
                .city_names = []
                .city_lats = []
                .city_lons = []
                .cities_pills = []
                var j int = 0
                for x in rm.ids {
                    .city_ids.push(rm.ids.get(j))
                    .city_names.push(rm.names.get(j))
                    .city_lats.push(rm.lats.get(j))
                    .city_lons.push(rm.lons.get(j))
                    if j == 0 {
                        .cities_pills.push({ id: rm.ids.get(j), disp: "★ " + rm.names.get(j) })
                    } else {
                        .cities_pills.push({ id: rm.ids.get(j), disp: rm.names.get(j) })
                    }
                    j = j + 1
                }
                if .city_ids.len() == 0 {
                    .cities_empty = true
                    .main_id = ""
                } else {
                    .cities_empty = false
                    .main_id = .city_ids.get(0)
                }
            }
        }

        .SetLayout(mode) -> {
            .layout_mode = mode
        }

        .SetForecastTab(tab) -> {
            .forecast_tab = tab
        }

        // r10+PLAN-009：真实刷新（Open-Meteo）；失败保留现状。updated_at
        // 先置哨兵——取数成功才回填；统一 report_at(cur_lat,cur_lon) 单通道，
        // 空表不取数
        .Refresh -> {
            .refreshing = true
            .updated_at = "--:--"
            if !.cities_empty {
                let r = weather_report_at(.cur_lat, .cur_lon, .s_temp_unit, .s_wind_unit, .lang)
                if r.ok {
                    .live = true
                    .condition = r.condition
                    .cond_zh = r.cond_zh
                    .icon = r.icon
                    .temp = r.temp
                    .feels = r.feels
                    .humidity = r.humidity
                    .wind = r.wind
                    .uv = r.uv
                    .aqi = r.aqi
                    .aqi_level = r.aqi_level
                    .pressure = r.pressure
                    .visibility = r.visibility
                    .updated_at = r.updated_at
                    .hourly = r.hourly
                    .daily = r.daily
                    .data_note = .t_live_pre + r.source
                    .source_label = r.source
                    .pm25 = r.pm25
                    .pm10 = r.pm10
                    .o3 = r.o3
                    .indices = r.indices
                    .precip = r.precip
                    .alert_level = r.alert_level
                    .alert_title = r.alert_title
                    .alert_text = r.alert_text
                }
            }
            .refreshing = false
        }

        .ToggleTheme -> {
            .dark_mode = !.dark_mode
        }

        .SetTheme(t) -> {
            if t == "light" {
                .dark_mode = false
            }
            if t == "dark" {
                .dark_mode = true
            }
        }

        .SetAccent(name) -> {
            .accent_color = name
        }
    }
}

