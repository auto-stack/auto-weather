                        text .data_note { style: "text-center text-[10px] text-muted-foreground/70" }

                        style: "w-full gap-3"
                    }
                }

                // ==================== 竖屏布局（保留：未来手机版） ====================
                if .layout_mode == "portrait" {
                    scroll (axis: "y", style: "w-full max-h-[520px]") {
                        col {
                            style: "w-full max-w-md mx-auto gap-3"

                            // PLAN-004：竖屏功能对齐——预警 banner/搜索/城市条
                            if .alert_title != "" {
                                row {
                                    style: "w-full items-center gap-2 px-3 py-2 rounded-2xl bg-amber-500/15 border border-amber-500/40"
                                    text .alert_level { style: "text-xs font-bold text-amber-600 shrink-0" }
                                    text .alert_title { style: "text-xs font-medium text-foreground" }
                                }
                            }
                            row {
                                style: "w-full items-center gap-2"
                                input { placeholder: "搜索城市（中文/拼音）", value: .search_q, oninput: .SearchChanged, style: "flex-1 px-3 py-1.5 text-xs rounded-full border border-border bg-background text-foreground outline-none" }
                                button "搜索" { onclick: .DoSearch, variant: "primary", style: refresh_idle }
                            }
                            if .search_err != "" {
                                text .search_err { style: hint_text }
                            }
                            row {
                                style: "w-full gap-2 flex-wrap"
                                for h in .search_hits {
                                    button h.label { onclick: .AddHit(h.id), variant: "secondary", style: city_pill_off }
                                }
                            }
                            // 城市 pill 条（竖屏与横屏同构）
                            col {
                                style: "w-full h-11 shrink-0"
                                scroll (axis: "x", style: "w-full h-full") {
                                    row {
                                        style: "items-center gap-2 h-full pr-2"
                                        if .city_id == "beijing" {
                                            button "北京" { onclick: .SelectCity("beijing"), variant: "primary", style: city_pill_on }
                                        } else {
                                            button "北京" { onclick: .SelectCity("beijing"), variant: "secondary", style: city_pill_off }
                                        }
                                        if .city_id == "shanghai" {
                                            button "上海" { onclick: .SelectCity("shanghai"), variant: "primary", style: city_pill_on }
                                        } else {
                                            button "上海" { onclick: .SelectCity("shanghai"), variant: "secondary", style: city_pill_off }
                                        }
                                        if .city_id == "guangzhou" {
                                            button "广州" { onclick: .SelectCity("guangzhou"), variant: "primary", style: city_pill_on }
                                        } else {
                                            button "广州" { onclick: .SelectCity("guangzhou"), variant: "secondary", style: city_pill_off }
                                        }
                                        if .city_id == "shenzhen" {
                                            button "深圳" { onclick: .SelectCity("shenzhen"), variant: "primary", style: city_pill_on }
                                        } else {
                                            button "深圳" { onclick: .SelectCity("shenzhen"), variant: "secondary", style: city_pill_off }
                                        }
                                        if .city_id == "hangzhou" {
                                            button "杭州" { onclick: .SelectCity("hangzhou"), variant: "primary", style: city_pill_on }
                                        } else {
                                            button "杭州" { onclick: .SelectCity("hangzhou"), variant: "secondary", style: city_pill_off }
                                        }
                                        if .city_id == "chengdu" {
                                            button "成都" { onclick: .SelectCity("chengdu"), variant: "primary", style: city_pill_on }
                                        } else {
                                            button "成都" { onclick: .SelectCity("chengdu"), variant: "secondary", style: city_pill_off }
                                        }
                                        if .city_id == "xian" {
                                            button "西安" { onclick: .SelectCity("xian"), variant: "primary", style: city_pill_on }
                                        } else {
                                            button "西安" { onclick: .SelectCity("xian"), variant: "secondary", style: city_pill_off }
                                        }
                                        if .city_id == "wuhan" {
                                            button "武汉" { onclick: .SelectCity("wuhan"), variant: "primary", style: city_pill_on }
                                        } else {
                                            button "武汉" { onclick: .SelectCity("wuhan"), variant: "secondary", style: city_pill_off }
                                        }
                                        if .city_id == "harbin" {
                                            button "哈尔滨" { onclick: .SelectCity("harbin"), variant: "primary", style: city_pill_on }
                                        } else {
                                            button "哈尔滨" { onclick: .SelectCity("harbin"), variant: "secondary", style: city_pill_off }
                                        }
                                        if .city_id == "sanya" {
                                            button "三亚" { onclick: .SelectCity("sanya"), variant: "primary", style: city_pill_on }
                                        } else {
