                                        }
                                        for c in .custom_pills {
                                            button c.name { onclick: .SelectCustom(c.id), variant: "secondary", style: city_pill_off }
                                            button "✕" { onclick: .RemoveCustom(c.id), variant: "secondary", style: "w-6 h-6 text-[10px] items-center justify-center rounded-full bg-secondary text-muted-foreground hover:bg-secondary/80 transition-colors shrink-0" }
                                        }
                                    }
                                }
                            }

                            // Hero
                            col {
                                style: if .condition == "sunny" {
                                    "bg-gradient-to-br from-amber-400 to-orange-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "rain" {
                                    "bg-gradient-to-br from-blue-400 to-blue-600 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "storm" {
                                    "bg-gradient-to-br from-indigo-500 to-purple-600 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "snow" {
                                    "bg-gradient-to-br from-cyan-300 to-sky-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "fog" {
                                    "bg-gradient-to-br from-gray-300 to-slate-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "cloudy" {
                                    "bg-gradient-to-br from-slate-400 to-slate-600 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else {
                                    "bg-gradient-to-br from-sky-400 to-blue-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                }
                                text .icon { style: "text-5xl" }
                                text .cond_zh { style: "text-base font-medium text-white" }
                                text .temp { style: "text-7xl font-light text-white leading-none tracking-tight" }
                                row {
                                    style: "items-center gap-3 text-white/90 text-xs mt-1"
                                    text f"体感 ${.feels}" {}
                                    text f"湿度 ${.humidity}" {}
                                    text f"风 ${.wind}" {}
                                }
                            }

                            // 指标
                            col {
                                style: "w-full gap-2"
                                text "当前详情" { style: section_title }
                                row {
                                    style: "w-full gap-2"
                                    col {
                                        style: metric_card
                                        text "湿度" { style: metric_label }
                                        text .humidity { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "风速" { style: metric_label }
                                        text .wind { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "体感" { style: metric_label }
                                        text .feels { style: metric_value }
                                    }
                                }
                                row {
                                    style: "w-full gap-2"
                                    col {
                                        style: metric_card
                                        text "紫外线" { style: metric_label }
                                        text .uv { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        row {
                                            style: "items-center gap-1"
                                            text "AQI" { style: metric_label }
                                            if .aqi_level == "优" {
                                                text .aqi_level { style: aqi_good }
                                            } else if .aqi_level == "轻度污染" {
                                                text .aqi_level { style: aqi_warn }
                                            } else {
                                                text .aqi_level { style: aqi_mid }
                                            }
                                        }
                                        text .aqi { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "能见度" { style: metric_label }
                                        text .visibility { style: metric_value }
                                    }
                                }
                                row {
                                    style: "w-full gap-2"
                                    col {
                                        style: metric_card
                                        text "气压" { style: metric_label }
                                        text .pressure { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "更新" { style: metric_label }
                                        text .updated_at { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "数据" { style: metric_label }
                                        text .source_label { style: "text-xs text-muted-foreground" }
                                    }
                                }
                                // PLAN-004：PM 行（竖屏对齐）
                                row {
                                    style: "w-full gap-2"
                                    col {
                                        style: metric_card
                                        text "PM2.5" { style: metric_label }
                                        text .pm25 { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "PM10" { style: metric_label }
                                        text .pm10 { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "O3" { style: metric_label }
                                        text .o3 { style: metric_value }
                                    }
                                }
                            }

                            // 预报 Tab（与横屏同构）
                            col {
                                style: forecast_card
                                row {
                                    style: "w-full items-center gap-2"
                                    if .forecast_tab == "hourly" {
                                        button "24小时" { onclick: .SetForecastTab("hourly"), variant: "primary", style: fc_tab_on }
                                    } else {
                                        button "24小时" { onclick: .SetForecastTab("hourly"), variant: "secondary", style: fc_tab_off }
                                    }
                                    if .forecast_tab == "daily" {
                                        button "5日" { onclick: .SetForecastTab("daily"), variant: "primary", style: fc_tab_on }
                                    } else {
                                        button "5日" { onclick: .SetForecastTab("daily"), variant: "secondary", style: fc_tab_off }
                                    }
                                }
                                if .forecast_tab == "hourly" {
                                    scroll (axis: "x", style: "w-full h-36") {
                                        row {
                                            style: "items-center gap-2 h-36"
                            for h in .hourly {
                                if h.time == "现在" {
                                    col {
                                        style: hour_card_now
                                        text h.time { style: "text-[10px] font-semibold text-primary" }
                                        text h.icon { style: "text-lg" }
                                        text h.temp { style: "text-sm font-bold text-primary" }
                                    }
                                } else {
                                    col {
                                        style: hour_card
                                        text h.time { style: "text-[10px] text-muted-foreground" }
                                        text h.icon { style: "text-lg" }
                                        text h.temp { style: "text-sm font-semibold text-foreground" }
                                    }
                                }
                            }
                                        }
                                    }
                                }
                                if .forecast_tab == "daily" {
                                    scroll (axis: "x", style: "w-full h-36") {
                                        row {
                                            style: "items-center gap-2 h-36"
                                            for d in .daily {
                                                if d.day == "今天" {
                                                    col {
                                                        style: day_card_now
                                                        text d.day { style: "text-[10px] font-semibold text-primary" }
                                                        text d.icon { style: "text-lg" }
                                                        text d.tmax { style: "text-sm font-bold text-primary" }
                                                        text d.tmin { style: "text-[10px] text-primary/70" }
                                                    }
                                                } else {
                                                    col {
                                                        style: day_card
                                                        text d.day { style: "text-[10px] text-muted-foreground" }
                                                        text d.icon { style: "text-lg" }
                                                        text d.tmax { style: "text-sm font-semibold text-foreground" }
                                                        text d.tmin { style: "text-[10px] text-muted-foreground" }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // PLAN-004：生活指数（竖屏 scroll-x 版；flex-wrap
                            // iced 不支持——plan412 降级矩阵在册）
                            col {
                                style: "w-full gap-2"
                                text "生活指数" { style: section_title }
                                scroll (axis: "x", style: "w-full h-24") {
                                    row {
                                        style: "items-center gap-2 h-20"
                                        for it in .indices {
                                            col {
                                                style: "w-20 shrink-0 bg-card border border-border rounded-2xl p-3 gap-1 items-center"
                                                text it.name { style: "text-[10px] text-muted-foreground" }
                                                text it.level { style: "text-sm font-semibold text-foreground" }
                                                text it.note { style: "text-[9px] text-muted-foreground text-center" }
                                            }
                                        }
                                    }
                                }
                            }
                            // PLAN-004：24小时降水（竖屏）
                            col {
                                style: "w-full gap-2"
                                text "24小时降水" { style: section_title }
                                scroll (axis: "x", style: "w-full h-28") {
                                    row {
                                        style: "items-end gap-1.5 h-24"
                                        for p in .precip {
                                            col {
                                                style: "w-10 shrink-0 items-center gap-0.5"
                                                text p.prob { style: "text-[9px] text-muted-foreground" }
                                                col {
                                                    style: p.bar
                                                }
                                                text p.time { style: "text-[9px] text-muted-foreground" }
                                                text p.amount { style: "text-[8px] text-muted-foreground/70" }
                                            }
                                        }
                                    }
                                }
                            }

                            text .data_note { style: "text-center text-[10px] text-muted-foreground/70" }

                            style: "w-full max-w-md mx-auto gap-3"
                        }
                    }
                }

                    style: app_frame
                }
                style: "w-full p-3 gap-3 items-center"
            }
            style: page
        }
    }

    on {
        // r9：a2r 不发射 app.at 顶层 fn 进 main.rs（E0425），handler 一律
        // 字面量 if/else 赋值，不调用 helper。键=中文城市名。
        .Init -> {
            .layout_mode = "landscape"
            .forecast_tab = "hourly"
            .city_id = "beijing"
            .city_zh = "北京"
            .condition = "partly"
            .cond_zh = "多云"
            .icon = "⛅"
            .temp = "23°"
            .feels = "25°"
            .humidity = "65%"
            .wind = "12 km/h"
            .uv = "中等"
            .aqi = "68"
            .aqi_level = "良"
            .pressure = "1012 hPa"
            .visibility = "12 km"
            .hourly = [
                { time: "现在", icon: "⛅", temp: "23°", now: true },
                { time: "15:00", icon: "⛅", temp: "23°", now: false },
                { time: "16:00", icon: "⛅", temp: "23°", now: false },
                { time: "17:00", icon: "☁️", temp: "23°", now: false },
                { time: "18:00", icon: "☁️", temp: "23°", now: false },
                { time: "19:00", icon: "☁️", temp: "23°", now: false },
                { time: "20:00", icon: "☁️", temp: "23°", now: false },
                { time: "21:00", icon: "⛅", temp: "23°", now: false }
            ]
            .daily = [
                { day: "今天", icon: "⛅", cond: "多云", tmin: "18°", tmax: "25°" },
                { day: "周二", icon: "☀️", cond: "晴", tmin: "20°", tmax: "28°" },
                { day: "周三", icon: "☁️", cond: "阴", tmin: "16°", tmax: "22°" },
                { day: "周四", icon: "🌧️", cond: "小雨", tmin: "17°", tmax: "24°" },
                { day: "周五", icon: "⛅", cond: "多云", tmin: "19°", tmax: "27°" }
            ]
            .updated_at = "14:30"
            // r10：起屏拉一次真实数据；失败静默保留上方演示样本
            let r = weather_report(.city_id)
            if r.ok {
                .condition = r.condition
                .cond_zh = r.cond_zh
                .icon = r.icon
                .temp = r.temp
                .feels = r.feels
                .humidity = r.humidity
                .wind = r.wind
                .uv = r.uv
                .aqi = r.aqi
                .aqi_level = r.aqi_level
                .pressure = r.pressure
                .visibility = r.visibility
                .updated_at = r.updated_at
                .hourly = r.hourly
                .daily = r.daily
                .data_note = "实时数据 · Open-Meteo"
                .source_label = "Open-Meteo"
                .pm25 = r.pm25
                .pm10 = r.pm10
                .o3 = r.o3
                .indices = r.indices
                .precip = r.precip
                .alert_level = r.alert_level
                .alert_title = r.alert_title
                .alert_text = r.alert_text
            }
            // PLAN-001：预填自定义城市（后端持久化；失败静默）
            let rc = cities_get()
            if rc.ok {
                var k int = 0
                for x in rc.ids {
                    .custom_ids.push(rc.ids.get(k))
                    .custom_names.push(rc.names.get(k))
                    .custom_lats.push(rc.lats.get(k))
                    .custom_lons.push(rc.lons.get(k))
                    .custom_pills.push({ id: rc.ids.get(k), name: rc.names.get(k) })
                    k = k + 1
                }
            }
        }

        // PLAN-001：搜索输入（单参直发，os-config e2e 规则）
        .SearchChanged(q) -> {
            .search_q = q
        }

        // PLAN-001：执行搜索——平行 str 数组物化为视图态列表
        .DoSearch -> {
            .search_err = ""
            .search_hits = []
            .search_ids = []
            .search_names = []
            .search_subs = []
            .search_lats = []
            .search_lons = []
            let r = weather_search(.search_q)
            if r.ok {
                var i int = 0
                for x in r.ids {
                    .search_ids.push(r.ids.get(i))
                    .search_names.push(r.names.get(i))
                    .search_subs.push(r.subs.get(i))
                    .search_lats.push(r.lats.get(i))
                    .search_lons.push(r.lons.get(i))
                    .search_hits.push({ id: r.ids.get(i), name: r.names.get(i), sub: r.subs.get(i), label: r.names.get(i) + " · " + r.subs.get(i) })
                    i = i + 1
                }
            }
            if .search_hits.len() == 0 {
                .search_err = "无结果（或网络不可用）"
            }
        }

        // PLAN-001：添加搜索结果为自定义城市（索引循环定位，handler 不读
        // 循环变量 map——VG4；cities_add 返回新表即刷新 pills）
        .AddHit(id) -> {
            .search_err = ""
            var i int = 0
            var found bool = false
            var nm str = ""
            var la str = ""
            var lo str = ""
            while i < .search_ids.len() {
                if .search_ids.get(i) == id {
                    found = true
                    nm = .search_names.get(i)
                    la = .search_lats.get(i)
                    lo = .search_lons.get(i)
                }
                i = i + 1
            }
            if found {
                let r2 = cities_add(id, nm, la, lo)
                if r2.ok {
                    .custom_ids = []
                    .custom_names = []
                    .custom_lats = []
                    .custom_lons = []
                    .custom_pills = []
                    var j int = 0
                    for x in r2.ids {
                        .custom_ids.push(r2.ids.get(j))
                        .custom_names.push(r2.names.get(j))
                        .custom_lats.push(r2.lats.get(j))
                        .custom_lons.push(r2.lons.get(j))
                        .custom_pills.push({ id: r2.ids.get(j), name: r2.names.get(j) })
                        j = j + 1
                    }
                    .search_hits = []
                    .search_q = ""
                }
            }
        }

        // PLAN-001：选中自定义城市——report_at 取数
        .SelectCustom(id) -> {
            .city_id = ""
            .active_custom = id
            .search_err = ""
            var i int = 0
            var found bool = false
            var nm str = ""
            var la str = ""
            var lo str = ""
            while i < .custom_ids.len() {
                if .custom_ids.get(i) == id {
                    found = true
                    nm = .custom_names.get(i)
                    la = .custom_lats.get(i)
                    lo = .custom_lons.get(i)
                }
                i = i + 1
            }
            if found {
                .city_zh = nm
                let r = weather_report_at(la, lo)
                if r.ok {
                    .condition = r.condition
                    .cond_zh = r.cond_zh
                    .icon = r.icon
                    .temp = r.temp
                    .feels = r.feels
                    .humidity = r.humidity
                    .wind = r.wind
                    .uv = r.uv
                    .aqi = r.aqi
                    .aqi_level = r.aqi_level
                    .pressure = r.pressure
                    .visibility = r.visibility
                    .updated_at = r.updated_at
                    .hourly = r.hourly
                    .daily = r.daily
                    .data_note = "实时数据 · Open-Meteo"
                    .source_label = "Open-Meteo"
                    .pm25 = r.pm25
                    .pm10 = r.pm10
                    .o3 = r.o3
                    .indices = r.indices
                    .precip = r.precip
                    .alert_level = r.alert_level
                    .alert_title = r.alert_title
                    .alert_text = r.alert_text
                }
            }
        }

        // PLAN-002：删除自定义城市（响应即新表，同 AddHit 物化模式）
        .RemoveCustom(id) -> {
            let r3 = cities_remove(id)
            if r3.ok {
                .custom_ids = []
                .custom_names = []
                .custom_lats = []
                .custom_lons = []
                .custom_pills = []
                var j int = 0
                for x in r3.ids {
                    .custom_ids.push(r3.ids.get(j))
                    .custom_names.push(r3.names.get(j))
                    .custom_lats.push(r3.lats.get(j))
                    .custom_lons.push(r3.lons.get(j))
                    .custom_pills.push({ id: r3.ids.get(j), name: r3.names.get(j) })
                    j = j + 1
                }
            }
        }

        .SetLayout(mode) -> {
            .layout_mode = mode
        }

        .SetForecastTab(tab) -> {
            .forecast_tab = tab
        }

        .SelectCity(id) -> {
            .city_id = id
            .active_custom = ""
            // ASCII id → 中文名 + 数据（避免 a2r 中文比较 mojibake）
            if id == "shanghai" {
                .city_zh = "上海"
            } else if id == "guangzhou" {
                .city_zh = "广州"
            } else if id == "shenzhen" {
                .city_zh = "深圳"
            } else if id == "hangzhou" {
                .city_zh = "杭州"
            } else if id == "chengdu" {
                .city_zh = "成都"
            } else if id == "xian" {
                .city_zh = "西安"
            } else if id == "wuhan" {
                .city_zh = "武汉"
            } else if id == "harbin" {
                .city_zh = "哈尔滨"
            } else if id == "sanya" {
                .city_zh = "三亚"
            } else {
                .city_zh = "北京"
            }
            if id == "上海" {
                .condition = "rain"
                .cond_zh = "小雨"
                .icon = "🌧️"
                .temp = "21°"
                .feels = "22°"
                .humidity = "82%"
                .wind = "15 km/h"
                .uv = "中等"
                .aqi = "55"
                .aqi_level = "良"
                .pressure = "1012 hPa"
                .visibility = "8 km"
            } else if id == "广州" {
                .condition = "sunny"
                .cond_zh = "晴"
                .icon = "☀️"
                .temp = "30°"
                .feels = "33°"
                .humidity = "70%"
                .wind = "8 km/h"
                .uv = "很强"
                .aqi = "42"
                .aqi_level = "优"
                .pressure = "1012 hPa"
                .visibility = "12 km"
            } else if id == "深圳" {
                .condition = "storm"
                .cond_zh = "雷阵雨"
                .icon = "⛈️"
                .temp = "28°"
                .feels = "31°"
                .humidity = "78%"
                .wind = "18 km/h"
                .uv = "中等"
                .aqi = "35"
                .aqi_level = "优"
                .pressure = "1012 hPa"
                .visibility = "12 km"
            } else if id == "杭州" {
                .condition = "rain"
                .cond_zh = "小雨"
                .icon = "🌧️"
                .temp = "22°"
                .feels = "23°"
                .humidity = "74%"
                .wind = "10 km/h"
                .uv = "中等"
                .aqi = "60"
                .aqi_level = "良"
                .pressure = "1012 hPa"
                .visibility = "8 km"
            } else if id == "成都" {
                .condition = "fog"
                .cond_zh = "雾"
                .icon = "🌫️"
                .temp = "20°"
                .feels = "21°"
                .humidity = "85%"
                .wind = "6 km/h"
                .uv = "弱"
                .aqi = "95"
                .aqi_level = "轻度污染"
                .pressure = "1008 hPa"
                .visibility = "3 km"
            } else if id == "西安" {
                .condition = "sunny"
                .cond_zh = "晴"
                .icon = "☀️"
                .temp = "25°"
                .feels = "24°"
                .humidity = "48%"
                .wind = "14 km/h"
                .uv = "很强"
                .aqi = "78"
                .aqi_level = "良"
                .pressure = "1012 hPa"
                .visibility = "12 km"
            } else if id == "武汉" {
                .condition = "partly"
                .cond_zh = "多云"
                .icon = "⛅"
                .temp = "27°"
                .feels = "29°"
                .humidity = "66%"
                .wind = "11 km/h"
                .uv = "中等"
                .aqi = "72"
                .aqi_level = "良"
                .pressure = "1012 hPa"
                .visibility = "12 km"
            } else if id == "哈尔滨" {
                .condition = "snow"
                .cond_zh = "小雪"
                .icon = "❄️"
                .temp = "-2°"
                .feels = "-6°"
                .humidity = "80%"
                .wind = "20 km/h"
                .uv = "弱"
                .aqi = "50"
                .aqi_level = "优"
                .pressure = "1028 hPa"
                .visibility = "5 km"
            } else if id == "三亚" {
                .condition = "sunny"
                .cond_zh = "晴"
                .icon = "☀️"
                .temp = "31°"
                .feels = "34°"
                .humidity = "72%"
                .wind = "16 km/h"
                .uv = "很强"
                .aqi = "28"
                .aqi_level = "优"
                .pressure = "1006 hPa"
                .visibility = "12 km"
            } else {
                .condition = "partly"
                .cond_zh = "多云"
                .icon = "⛅"
                .temp = "23°"
                .feels = "25°"
                .humidity = "65%"
                .wind = "12 km/h"
                .uv = "中等"
                .aqi = "68"
                .aqi_level = "良"
                .pressure = "1012 hPa"
                .visibility = "12 km"
            }
            .hourly = [
                { time: "现在", icon: .icon, temp: .temp, now: true },
                { time: "15:00", icon: .icon, temp: .temp, now: false },
                { time: "16:00", icon: .icon, temp: .temp, now: false },
                { time: "17:00", icon: .icon, temp: .temp, now: false },
                { time: "18:00", icon: .icon, temp: .temp, now: false },
                { time: "19:00", icon: .icon, temp: .temp, now: false },
                { time: "20:00", icon: .icon, temp: .temp, now: false },
                { time: "21:00", icon: .icon, temp: .temp, now: false }
            ]
            .daily = [
                { day: "今天", icon: .icon, cond: .cond_zh, tmin: .temp, tmax: .temp },
                { day: "周二", icon: .icon, cond: .cond_zh, tmin: .temp, tmax: .temp },
                { day: "周三", icon: "☁️", cond: "阴", tmin: .temp, tmax: .temp },
                { day: "周四", icon: "🌧️", cond: "小雨", tmin: .temp, tmax: .temp },
                { day: "周五", icon: "⛅", cond: "多云", tmin: .temp, tmax: .temp }
            ]
            // r10：切城后拉真实数据；失败保留上方该城演示样本
            let r = weather_report(id)
            if r.ok {
                .condition = r.condition
                .cond_zh = r.cond_zh
                .icon = r.icon
                .temp = r.temp
                .feels = r.feels
                .humidity = r.humidity
                .wind = r.wind
                .uv = r.uv
                .aqi = r.aqi
                .aqi_level = r.aqi_level
                .pressure = r.pressure
                .visibility = r.visibility
                .updated_at = r.updated_at
                .hourly = r.hourly
                .daily = r.daily
                .data_note = "实时数据 · Open-Meteo"
                .source_label = "Open-Meteo"
                .pm25 = r.pm25
                .pm10 = r.pm10
                .o3 = r.o3
                .indices = r.indices
                .precip = r.precip
                .alert_level = r.alert_level
                .alert_title = r.alert_title
                .alert_text = r.alert_text
            }
        }

        .Refresh -> {
            .refreshing = true
            // r10+PLAN-004：真实刷新（Open-Meteo）；失败保留现状。updated_at
            // 先置哨兵——取数成功才回填（自定义通道可观察性）；active_custom
            // 非空走 report_at，否则内置 weather_report。
            .updated_at = "--:--"
            var did_custom bool = false
            if .active_custom != "" {
                var i int = 0
                var found bool = false
                var la str = ""
                var lo str = ""
                while i < .custom_ids.len() {
                    if .custom_ids.get(i) == .active_custom {
                        found = true
                        la = .custom_lats.get(i)
                        lo = .custom_lons.get(i)
                    }
                    i = i + 1
                }
                if found {
                    did_custom = true
                    let rc2 = weather_report_at(la, lo)
                    if rc2.ok {
                        .condition = rc2.condition
                        .cond_zh = rc2.cond_zh
                        .icon = rc2.icon
                        .temp = rc2.temp
                        .feels = rc2.feels
                        .humidity = rc2.humidity
                        .wind = rc2.wind
                        .uv = rc2.uv
                        .aqi = rc2.aqi
                        .aqi_level = rc2.aqi_level
                        .pressure = rc2.pressure
                        .visibility = rc2.visibility
                        .updated_at = rc2.updated_at
                        .hourly = rc2.hourly
                        .daily = rc2.daily
                        .data_note = "实时数据 · Open-Meteo"
                        .source_label = "Open-Meteo"
                        .pm25 = rc2.pm25
                        .pm10 = rc2.pm10
                        .o3 = rc2.o3
                        .indices = rc2.indices
                        .precip = rc2.precip
                        .alert_level = rc2.alert_level
                        .alert_title = rc2.alert_title
                        .alert_text = rc2.alert_text
                    }
                }
            }
            if !did_custom {
                let r = weather_report(.city_id)
                if r.ok {
                    .condition = r.condition
                    .cond_zh = r.cond_zh
                    .icon = r.icon
                    .temp = r.temp
                    .feels = r.feels
                    .humidity = r.humidity
                    .wind = r.wind
                    .uv = r.uv
                    .aqi = r.aqi
                    .aqi_level = r.aqi_level
                    .pressure = r.pressure
                    .visibility = r.visibility
                    .updated_at = r.updated_at
                    .hourly = r.hourly
                    .daily = r.daily
                    .data_note = "实时数据 · Open-Meteo"
                    .source_label = "Open-Meteo"
                    .pm25 = r.pm25
                    .pm10 = r.pm10
                    .o3 = r.o3
                    .indices = r.indices
                    .precip = r.precip
                    .alert_level = r.alert_level
                    .alert_title = r.alert_title
                    .alert_text = r.alert_text
                }
            }
            .refreshing = false
        }

        .ToggleTheme -> {
            .dark_mode = !.dark_mode
        }

        .SetTheme(t) -> {
            if t == "light" {
                .dark_mode = false
            }
            if t == "dark" {
                .dark_mode = true
            }
        }

        .SetAccent(name) -> {
            .accent_color = name
        }
    }
}

