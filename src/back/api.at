// api.at — 014-weather 后端天气代理（v0.6-dev）
#[script]
//
// PLAN-001：城市搜索与多城市管理（PLAN-001，分支 plan-001-dev）。
// 前端只打本地 /api/weather/*；本文件代理 Open-Meteo（免注册免 key，
// 非商用免费档）：forecast（实时+24h+5日）、air-quality（AQI）、
// geocoding（城市搜索）。失败一律 ok:false + 错误串，前端保留演示样本
// 兜底（降级契约与 027-file-manager rev7 同构）。
//
// QWeather 路线（PLAN-005 定案）：控制台"凭据"选 **API KEY** 类型，经
// `?key=` 查询参数认证（Bearer 头 401 实测——与社区文档口径不符，以
// 实测为准），无需本地签名。JWT 型凭据（kid 入 header、Ed25519 私钥
// 签名）的 Bearer 401 未解之谜（公钥保存/项目归属）搁置备查；将来
// auto-lang crypto 面落地后可无损切换。key 经 QWEATHER_KEY env 注入、
// 严禁入库；QWEATHER_HOST 可覆盖（默认 na3h2ttjx8.re.qweatherapi.com）。
//
// ⚠ VM 轨实证配方（2026-10-04 本仓实测，见 docs/design/weather-v2.md §6）：
//   - 结构纪律（027 rev7）：#[api] 端点体恒 thin——api_gen 内联面无法
//     转译 http/JsonValue，胖体会让 rust 后端编译错；thin 体落 Default
//     桩（Vue 轨演示数据），VM merged 会话整文件执行 impl_*（真数据面）；
//   - json.parse 结果只认**点访问/for-in/""+ 强转**：.get()/.type() 等
//     方法表不存在（CALL_SPEC 实证）；原始 JSON 文本另有 json.get 文本
//     工具链可备用；
//   - 平行数组（Open-Meteo 响应形态）拆两遍 for-in 预生成真列表，再按
//     计数器 .get(i) 对齐（parse 结果上禁用 len，F-8 语义缺陷）；
//   - JSON float 字段经 let 绑定后直接 as int 读到装箱垃圾——经算术去
//     装箱（f2i 的 f + 0.0）或经 typed fn 参数；
//   - 坐标全链路透传 2dp 文本（fmt_latlon 全整数运算），避免 float→str
//     转换面缺失；城市 id = lat_lon；
//   - fn 模块内不 `use auto.str`（VG1）；字符串拼接不跨行 `+` 续行；
//   - 数组不跨 fn 边界传参（VG13），全部就地构建返回；
//   - cast 复合表达式 a2r 丢内层括号（jade DEBTS 013）→ let 中转变量；
//   - http 用便捷函数 http.get（非 builder 链，规避旧状态污染问题）。

pub type HourPoint = {
    time: str
    icon: str
    temp: str
    now: bool
}

pub type DayPoint = {
    day: str
    icon: str
    cond: str
    tmin: str
    tmax: str
}

// 全扁平标量 + 两个列表（前端 handler 单跳读契约）
// PLAN-002：pm25/pm10/o3（AQI 组分，软失败 "—"）+ indices（生活指数）
pub type ReportOut = {
    ok: bool
    error: str
    source: str
    condition: str
    cond_zh: str
    icon: str
    temp: str
    feels: str
    humidity: str
    wind: str
    wind_dir: str
    pressure: str
    visibility: str
    uv: str
    aqi: str
    aqi_level: str
    pm25: str
    pm10: str
    o3: str
    updated_at: str
    hourly: []HourPoint
    daily: []DayPoint
    indices: []LifeIndex
    precip: []PrecipPoint
    // PLAN-003 预警展示位：空串 = 无预警（内容待 PLAN-005 QWeather）
    alert_level: str
    alert_title: str
    alert_text: str
}

pub type LifeIndex = {
    name: str
    level: str
    note: str
}

// PLAN-003：24h 降水点（bar = 后端拼好的 Tailwind class，前端 style 绑定）
pub type PrecipPoint = {
    time: str
    prob: str
    amount: str
    bar: str
}

// PLAN-001：搜索/城市列表契约——平行 str 数组（前端索引循环物化）
pub type SearchOut = {
    ok: bool
    error: str
    ids: []str
    names: []str
    subs: []str
    lats: []str
    lons: []str
}

pub type CityListOut = {
    ok: bool
    error: str
    ids: []str
    names: []str
    lats: []str
    lons: []str
}

// PLAN-006 设置面 / PLAN-009 五字段化（整对象替换；缺省 c/kmh/zh/main/""）
// 删 default_city（启动落点改由 cities.json 位置 0 主城市 + startup/last_id 表达）
pub type SettingsOut = {
    ok: bool
    error: str
    temp_unit: str
    wind_unit: str
    lang: str
    startup: str
    last_id: str
}

// ── 城市坐标表（内置城市 id → Open-Meteo 纬经度，2 位小数）──
fn coords_for(city str) str {
    if city == "beijing" { return "39.90,116.40" }
    if city == "shanghai" { return "31.23,121.47" }
    if city == "guangzhou" { return "23.13,113.26" }
    if city == "shenzhen" { return "22.54,114.06" }
    if city == "hangzhou" { return "30.25,120.17" }
    if city == "chengdu" { return "30.57,104.07" }
    if city == "xian" { return "34.34,108.94" }
    if city == "wuhan" { return "30.59,114.31" }
    if city == "harbin" { return "45.80,126.53" }
    if city == "sanya" { return "18.25,109.51" }
    return ""
}

// ── PLAN-007 i18n：两语收口（扩展第三语时改表驱动）──
fn L(zh str, en str, lang str) str {
    if lang == "en" {
        return en
    }
    return zh
}

// QW cond 文案：T-02 probe 实证三端点支持 lang 参数（current/hourly/daily
// 加 &lang= 后 text 随语言返回），直取 API 本地化 text，无需本地英文表。

fn aq_level_en(zh str) str {
    if zh == "优" { return "Good" }
    if zh == "良" { return "Moderate" }
    if zh == "轻度污染" { return "Unhealthy for Sensitive" }
    if zh == "中度污染" { return "Unhealthy" }
    if zh == "重度污染" { return "Very Unhealthy" }
    if zh == "严重污染" { return "Hazardous" }
    return zh
}

// ── WMO weather_code → condition / 中文|英文 / 图标 ──
fn condition_for(code int) str {
    if code == 0 { return "sunny" }
    if code == 1 || code == 2 { return "partly" }
    if code == 3 { return "cloudy" }
    if code == 45 || code == 48 { return "fog" }
    if code >= 51 && code <= 67 { return "rain" }
    if code >= 71 && code <= 77 { return "snow" }
    if code >= 80 && code <= 82 { return "rain" }
    if code >= 85 && code <= 86 { return "snow" }
    if code >= 95 { return "storm" }
    return "cloudy"
}

fn cond_zh_for(code int, lang str) str {
    if code == 0 { return L("晴", "Clear", lang) }
    if code == 1 || code == 2 { return L("多云", "Partly Cloudy", lang) }
    if code == 3 { return L("阴", "Overcast", lang) }
    if code == 45 || code == 48 { return L("雾", "Fog", lang) }
    if code == 51 || code == 53 || code == 55 { return L("毛毛雨", "Drizzle", lang) }
    if code == 56 || code == 57 { return L("冻毛毛雨", "Freezing Drizzle", lang) }
    if code == 61 { return L("小雨", "Light Rain", lang) }
    if code == 63 { return L("中雨", "Rain", lang) }
    if code == 65 { return L("大雨", "Heavy Rain", lang) }
    if code == 66 || code == 67 { return L("冻雨", "Freezing Rain", lang) }
    if code == 71 { return L("小雪", "Light Snow", lang) }
    if code == 73 { return L("中雪", "Snow", lang) }
    if code == 75 { return L("大雪", "Heavy Snow", lang) }
    if code == 77 { return L("雪粒", "Snow Grains", lang) }
    if code == 80 || code == 81 || code == 82 { return L("阵雨", "Showers", lang) }
    if code == 85 || code == 86 { return L("阵雪", "Snow Showers", lang) }
    if code == 95 { return L("雷阵雨", "Thunderstorm", lang) }
    if code == 96 || code == 99 { return L("雷阵雨伴冰雹", "Thunderstorm with Hail", lang) }
    return L("阴", "Overcast", lang)
}

fn icon_for(code int) str {
    if code == 0 { return "☀️" }
    if code == 1 || code == 2 { return "⛅" }
    if code == 3 { return "☁️" }
    if code == 45 || code == 48 { return "🌫️" }
    if code >= 51 && code <= 67 { return "🌧️" }
    if code >= 71 && code <= 77 { return "❄️" }
    if code >= 80 && code <= 82 { return "🌧️" }
    if code >= 85 && code <= 86 { return "❄️" }
    if code >= 95 { return "⛈️" }
    return "☁️"
}

// ── 格式化助手（标量跨 fn 边界安全）──
// cast 复合表达式 a2r 丢括号（jade DEBTS 013）→ 先 let 中转变量。
fn fmt_i(f float) str {
    if f < 0.0 {
        let r float = f - 0.5
        return (r as int).str()
    }
    let r2 float = f + 0.5
    return (r2 as int).str()
}

// JSON float 字段经 let 绑定后直接 as int 会读到装箱垃圾（实测）——
// 统一走 f2i（+0.0 算术去装箱后截断，非四舍五入；四舍五入用 fmt_i）。
fn f2i(f float) int {
    let r float = f + 0.0
    return (r as int)
}

fn pad2(n int) str {
    if n < 10 { return "0" + n.str() }
    return n.str()
}

// 原始 JSON 文本扫描数字数组（for-in 循环变量的数字字段读出面中毒
// ——字符串/点访问正常，saturation/garbage 双重实证；改为对 raw 文本
// 做 key 定位 + 纯字符串截取，100% 已证面）
fn scan_numlist(raw str, key str) []str {
    var out []str = []
    var rest str = raw
    while rest.find(key) >= 0 {
        let pos int = rest.find(key)
        let tail str = rest.sub(pos + key.len(), rest.len())
        let end int = tail.find(",")
        if end < 0 {
            rest = ""
        } else {
            out.push(latlon_2dp(tail.sub(0, end)))
            rest = tail.sub(end, tail.len())
        }
    }
    return out
}

// PLAN-003：原始段变体（不做 2dp 截断；调用方自判 "null" 哨兵）
fn scan_raw_segments(raw str, key str) []str {
    var out []str = []
    var rest str = raw
    while rest.find(key) >= 0 {
        let pos int = rest.find(key)
        let tail str = rest.sub(pos + key.len(), rest.len())
        let end int = tail.find(",")
        if end < 0 {
            rest = ""
        } else {
            out.push(tail.sub(0, end))
            rest = tail.sub(end, tail.len())
        }
    }
    return out
}

// 降水概率段 → int（"null" → -1 哨兵；负值前端显示 "—"）
fn prob_seg_to_i(seg str) int {
    if seg == "null" { return -1 }
    let v int = (str.to_uint(seg)) as int
    return v
}

// 原始十进制串 → 2dp 文本（纯字符串运算；loop-var 数字字段的 float 面
// 会装箱中毒——saturation 实证，见 PLAN-002 记录）
fn latlon_2dp(raw str) str {
    let dot int = raw.find(".")
    if dot < 0 { return raw + ".00" }
    let ip str = raw.sub(0, dot)
    var fp str = raw.sub(dot + 1, raw.len())
    if fp.len() >= 2 { return ip + "." + fp.sub(0, 2) }
    if fp.len() == 1 { return ip + "." + fp + "0" }
    return ip + ".00"
}

// 坐标 → 2dp 文本（全整数运算；report 路径用，search 路径走 latlon_2dp）
fn fmt_latlon(f float) str {
    let v100 int = f2i(f * 100.0 + 0.5)
    let ip int = v100 / 100
    var fp int = v100 - ip * 100
    if fp < 0 { fp = 0 - fp }
    if ip < 0 {
        return "-" + ((0 - ip)).str() + "." + pad2(fp)
    }
    return ip.str() + "." + pad2(fp)
}

// PLAN-006：温度出口单点（ut=="f" 华氏；复合算术 let 中转，a2r 括号债规避）
fn temp_s(f float, ut str) str {
    if ut == "f" {
        let c float = f * 1.8 + 32.0
        return fmt_i(c) + "°F"
    }
    return fmt_i(f) + "°"
}

fn uv_level(v float, lang str) str {
    if v < 3.0 { return L("弱", "Low", lang) }
    if v < 6.0 { return L("中等", "Moderate", lang) }
    if v < 8.0 { return L("强", "High", lang) }
    if v < 11.0 { return L("很强", "Very High", lang) }
    return L("极强", "Extreme", lang)
}

fn aqi_level(a int, lang str) str {
    if a <= 50 { return L("优", "Good", lang) }
    if a <= 100 { return L("良", "Moderate", lang) }
    if a <= 150 { return L("轻度污染", "Unhealthy for Sensitive", lang) }
    if a <= 200 { return L("中度污染", "Unhealthy", lang) }
    if a <= 300 { return L("重度污染", "Very Unhealthy", lang) }
    return L("严重污染", "Hazardous", lang)
}

fn wind_dir_name(deg int, lang str) str {
    if lang == "en" {
        var dirs_en = ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]
        return dirs_en[((deg + 23) / 45) % 8]
    }
    var dirs = ["北", "东北", "东", "东南", "南", "西南", "西", "西北"]
    return dirs[((deg + 23) / 45) % 8]
}

// ── PLAN-002 生活指数推导（纯标量；PLAN-007 双语化）──
fn is_rain_code(code int) bool {
    if code >= 51 && code <= 67 { return true }
    if code >= 80 && code <= 82 { return true }
    if code >= 95 { return true }
    return false
}

fn index_dressing(feels float, lang str) str {
    if feels < 0.0 { return L("羽绒服", "Winter coat", lang) }
    if feels < 10.0 { return L("厚外套", "Thick coat", lang) }
    if feels < 18.0 { return L("薄外套", "Light jacket", lang) }
    if feels < 24.0 { return L("长袖衬衫", "Long sleeves", lang) }
    if feels < 30.0 { return L("短袖", "T-shirt", lang) }
    return L("清凉夏装", "Summer wear", lang)
}

fn index_carwash(rain12h bool, precip float, lang str) str {
    if rain12h { return L("不宜", "Not advised", lang) }
    if precip > 0.0 { return L("不宜", "Not advised", lang) }
    return L("适宜", "Good", lang)
}

fn index_sport(t float, aqi int, precip float, lang str) str {
    if precip > 0.0 { return L("不宜", "Not advised", lang) }
    if t < 5.0 || t > 32.0 { return L("不宜", "Not advised", lang) }
    if aqi > 150 { return L("不宜", "Not advised", lang) }
    if t >= 10.0 && t <= 28.0 && aqi <= 100 { return L("适宜", "Good", lang) }
    return L("较适宜", "Fair", lang)
}

fn index_cold(tmax float, tmin float, lang str) str {
    if tmin <= 5.0 { return L("较易发", "Likely", lang) }
    let swing float = tmax - tmin
    if swing >= 10.0 { return L("较易发", "Likely", lang) }
    return L("少发", "Unlikely", lang)
}

// PLAN-003：降水 bar class 拼装（高 6 档按量、色 5 档按概率）
fn precip_bar(prob int, amt float) str {
    var h str = "h-1"
    if amt >= 8.0 {
        h = "h-6"
    } else if amt >= 3.0 {
        h = "h-5"
    } else if amt >= 1.0 {
        h = "h-4"
    } else if amt >= 0.3 {
        h = "h-3"
    } else if amt >= 0.05 {
        h = "h-2"
    }
    var c str = "bg-muted/40"
    if prob < 0 {
        c = "bg-muted/40"
    } else if prob < 30 {
        c = "bg-sky-300/70"
    } else if prob < 60 {
        c = "bg-sky-400"
    } else if prob < 85 {
        c = "bg-sky-500"
    } else {
        c = "bg-sky-600"
    }
    return "w-4 rounded-t shrink-0 " + c + " " + h
}

// Sakamoto 星期（0=周日），日期串 "YYYY-MM-DD"——委托 weekday_calc
// （PLAN-005 抽出复用：QW UTC 日界需 +8h 后日期算星期；PLAN-007 lang 透传）
fn weekday_zh(ds str, lang str) str {
    let p = ds.split("-")
    if p.len() < 3 { return "" }
    let y int = (str.to_uint(p[0])) as int
    let m int = (str.to_uint(p[1])) as int
    let d int = (str.to_uint(p[2])) as int
    return weekday_calc(y, m, d, lang)
}


// os-config 配方：JSON 字符串值转义
fn quote_json(s str) str {
    let esc = s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "")
    return "\"" + esc + "\""
}

// GET 文本；传输异常由调用方 try/catch（PLAN-712 T-17 语义）
fn get_text(url str) str {
    let res = http.get(url)
    if res.status() != 200 {
        return ""
    }
    return res.body()
}

// ── PLAN-005 QWeather provider ──
// API KEY 型凭据经实测用 ?key= 查询参数认证（Bearer 头 401——与社区文档
// 口径不符，以实测为准）；JWT 型凭据的 Bearer 401 之谜（公钥保存/项目
// 归属）搁置备查。配置：QWEATHER_KEY（必填，空=不启用）、QWEATHER_HOST
// （默认 na3h2ttjx8.re.qweatherapi.com）。覆盖策略：OM 基线跑完仍成立，
// 四段各自 try 覆盖、失败保留 OM 字段。
fn qw_key() str {
    return env.get("QWEATHER_KEY")
}

fn qw_host() str {
    let h str = env.get("QWEATHER_HOST")
    if h != "" {
        return h
    }
    return "na3h2ttjx8.re.qweatherapi.com"
}

// 和风天气码 → 类别（cond_zh 直接用 API 本地化 text，无需中文映射表）
fn qw_condition(code int) str {
    if code >= 300 && code < 400 {
        if code == 302 || code == 303 || code == 304 {
            return "storm"
        }
        return "rain"
    }
    if code >= 400 && code < 500 {
        return "snow"
    }
    if code >= 500 && code < 600 {
        return "fog"
    }
    if code == 100 {
        return "sunny"
    }
    if code == 104 {
        return "cloudy"
    }
    return "partly"
}

// UTC ISO 段 → 北京时刻（+8；不涉日期进位——标签级精度可接受）
fn mh_plus8(iso str) str {
    let hh str = iso.sub(11, 13)
    var h int = (str.to_uint(hh)) as int
    h = (h + 8) % 24
    return pad2(h) + ":" + iso.sub(14, 16)
}

fn hh_label8(iso str) str {
    let hh2 str = iso.sub(11, 13)
    var h2 int = (str.to_uint(hh2)) as int
    h2 = (h2 + 8) % 24
    return pad2(h2) + ":00"
}

// 实况段覆盖（QW /weather/v1/current/{lat}/{lon}）
fn qw_current(out ReportOut, lat str, lon str, ut str, uw str, lang str) {
    let url str = "https://" + qw_host() + "/weather/v1/current/" + lat + "/" + lon + "?key=" + qw_key() + "&lang=" + lang
    let raw str = get_text(url)
    if raw == "" {
        return
    }
    let v = json.parse(raw)
    if v == nil {
        return
    }
    // 根即数据（无包裹层）；缺失字段点访问得 nil → 算术抛 → 段级 catch 保 OM
    let code int = (str.to_uint("" + v.condition.code)) as int
    out.condition = qw_condition(code)
    // T-02 probe 实证：QW 三端点均支持 lang 参数（lang=en → "Sunny"），
    // cond 直接用 API 本地化 text
    out.cond_zh = "" + v.condition.text
    out.icon = icon_for(out.condition)
    let tc float = v.temperature.value
    let fl float = v.feelsLike.value
    out.temp = temp_s(tc, ut)
    out.feels = temp_s(fl, ut)
    let hu float = v.humidity
    out.humidity = fmt_i(hu * 100.0) + "%"
    let wv float = v.wind.speed.value
    if uw == "ms" {
        out.wind = fmt_i(wv) + " m/s"
    } else {
        let wk float = wv * 3.6
        out.wind = fmt_i(wk) + " km/h"
    }
    let dg float = v.wind.direction.degree
    out.wind_dir = wind_dir_name(f2i(dg), lang)
    let pr float = v.pressure.value
    out.pressure = fmt_i(pr) + " hPa"
    let vi float = v.visibility.value
    out.visibility = fmt_i(vi / 1000.0) + " km"
    let uvf float = v.uvIndex
    out.uv = uv_level(uvf, lang)
    let ot = v.obsTime
    if ot != nil {
        out.updated_at = mh_plus8("" + ot)
    }
    out.source = "QWeather"
}

// 24h 小时段覆盖（QW /weather/v1/hourly；hours[].forecastTime 为 UTC）
fn qw_hourly(out ReportOut, lat str, lon str, ut str, lang str) {
    let url str = "https://" + qw_host() + "/weather/v1/hourly/" + lat + "/" + lon + "?key=" + qw_key() + "&lang=" + lang
    let raw str = get_text(url)
    if raw == "" {
        return
    }
    let v = json.parse(raw)
    if v == nil {
        return
    }
    let hs = v.hours
    if hs == nil {
        return
    }
    var pts []HourPoint = []
    var n int = 0
    for h in hs {
        if n >= 24 {
            n = n + 1
            continue
        }
        var lb str = L("现在", "Now", lang)
        if n != 0 {
            lb = hh_label8("" + h.forecastTime)
        }
        let hc int = (str.to_uint("" + h.condition.code)) as int
        let cat str = qw_condition(hc)
        let tv float = h.temperature.value
        pts.push(HourPoint {
            time: lb,
            icon: icon_for(cat),
            temp: temp_s(tv, ut),
            now: n == 0
        })
        n = n + 1
    }
    if pts.len() > 0 {
        out.hourly = pts
    }
}

// 5 日段覆盖（QW /weather/v1/daily；UTC 日界 = 北京 08:00，星期按 +8 后日期）
fn qw_daily(out ReportOut, lat str, lon str, ut str, lang str) {
    let url str = "https://" + qw_host() + "/weather/v1/daily/" + lat + "/" + lon + "?key=" + qw_key() + "&lang=" + lang
    let raw str = get_text(url)
    if raw == "" {
        return
    }
    let v = json.parse(raw)
    if v == nil {
        return
    }
    let ds = v.days
    if ds == nil {
        return
    }
    var pts []DayPoint = []
    var n int = 0
    for d in ds {
        if n >= 5 {
            n = n + 1
            continue
        }
        var lb str = weekday8("" + d.forecastStartTime, lang)
        if n == 0 {
            lb = L("今天", "Today", lang)
        }
        let hc int = (str.to_uint("" + d.daytime.condition.code)) as int
        let cat str = qw_condition(hc)
        let tmax float = d.temperatureMax
        let tmin float = d.temperatureMin
        // probe 实证 lang 直达 API；text 已随 lang 本地化
        var czh str = "" + d.daytime.condition.text
        pts.push(DayPoint {
            day: lb,
            icon: icon_for(cat),
            cond: czh,
            tmin: temp_s(tmin, ut),
            tmax: temp_s(tmax, ut)
        })
        n = n + 1
    }
    if pts.len() > 0 {
        out.daily = pts
    }
}

// forecastStartTime（UTC ISO）+8h 后的日期算星期（Sakamoto 复用）
fn weekday8(utc_iso str, lang str) str {
    // 小时 +8 可能跨日：仅当原时刻 ≥16:00 时日期+1（进位精确到日界）
    let hh str = utc_iso.sub(11, 13)
    var day_add int = 0
    var h int = (str.to_uint(hh)) as int
    h = (h + 8) % 24
    let h_orig int = (str.to_uint(utc_iso.sub(11, 13))) as int
    if h_orig >= 16 {
        day_add = 1
    }
    let ds str = utc_iso.sub(0, 10)
    // 日期 +day_add：借 weekday_zh 的原实现按 "YYYY-MM-DD" 计算，跨月
    // 进位用近似（遇月末偏差一天可接受；QW 预报最远第 7 天）
    var y int = (str.to_uint(ds.sub(0, 4))) as int
    var m int = (str.to_uint(ds.sub(5, 7))) as int
    var d int = (str.to_uint(ds.sub(8, 10))) as int
    if day_add == 1 {
        d = d + 1
    }
    return weekday_calc(y, m, d, lang)
}

// Sakamoto（0=周日）——由 weekday_zh 抽出以便 weekday8 复用
fn weekday_calc(y int, m int, d int, lang str) str {
    var names = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"]
    if lang == "en" {
        names = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    }
    var yy int = y
    if m < 3 {
        yy = yy - 1
    }
    var t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    let wk int = (yy + yy / 4 - yy / 100 + yy / 400 + t[m - 1] + d) % 7
    return names[wk]
}

// 空气段覆盖（QW /airquality/v1/current；indexes[0]=cn-mee，category 恒中文）
fn qw_air(out ReportOut, lat str, lon str, lang str) {
    let url str = "https://" + qw_host() + "/airquality/v1/current/" + lat + "/" + lon + "?key=" + qw_key()
    let raw str = get_text(url)
    if raw == "" {
        return
    }
    let v = json.parse(raw)
    if v == nil {
        return
    }
    let idxs = v.indexes
    if idxs != nil {
        for ix in idxs {
            let code str = "" + ix.code
            if code == "cn-mee" {
                out.aqi = "" + ix.aqiDisplay
                out.aqi_level = "" + ix.category
                if lang == "en" {
                    out.aqi_level = aq_level_en(out.aqi_level)
                }
            }
        }
    }
    let pols = v.pollutants
    if pols != nil {
        for p in pols {
            let pc str = "" + p.code
            let cv float = p.concentration.value
            if pc == "pm2p5" {
                out.pm25 = fmt_i(cv)
            }
            if pc == "pm10" {
                out.pm10 = fmt_i(cv)
            }
            if pc == "o3" {
                out.o3 = fmt_i(cv)
            }
        }
    }
}

// 覆盖层编排：四段独立 try，失败保留 OM 基线
fn qw_overlay(out ReportOut, lat str, lon str, ut str, uw str, lang str) {
    if qw_key() == "" {
        return
    }
    try {
        qw_current(out, lat, lon, ut, uw, lang)
    } catch {
    }
    try {
        qw_hourly(out, lat, lon, ut, lang)
    } catch {
    }
    try {
        qw_daily(out, lat, lon, ut, lang)
    } catch {
    }
    try {
        qw_air(out, lat, lon, lang)
    } catch {
    }
}

// ── PLAN-001：城市搜索（Open-Meteo Geocoding）──
fn impl_search(q str, lang str) SearchOut {
    var out SearchOut = SearchOut {
        ok: false,
        error: "",
        ids: [],
        names: [],
        subs: [],
        lats: [],
        lons: []
    }
    try {
        // q 直接透传 UTF-8 原始串（Open-Meteo 接受；encode_query_component
        // 在 server 模式 VM 上未实证，避开）
        let url str = "https://geocoding-api.open-meteo.com/v1/search?name=" + q + "&count=8&language=" + lang + "&format=json"
        let raw str = get_text(url)
        if raw == "" {
            out.error = "geocode request failed"
            return out
        }
        let v = json.parse(raw)
        if v == nil {
            out.error = "geocode parse failed"
            return out
        }
        let rs = v.results
        if rs != nil {
            // 坐标走 raw 文本扫描（循环变量数字字段中毒实证——见
            // scan_numlist 注记）；名称/副标题走 for-in 字符串面
            let glats []str = scan_numlist(raw, "\"latitude\":")
            let glons []str = scan_numlist(raw, "\"longitude\":")
            var gi int = 0
            for r in rs {
                let nm str = "" + r.name
                var sub str = "" + r.country
                let a1 = r.admin1
                if a1 != nil {
                    sub = sub + " " + a1
                }
                var lats str = "0.00"
                var lons str = "0.00"
                if gi < glats.len() {
                    lats = glats.get(gi)
                }
                if gi < glons.len() {
                    lons = glons.get(gi)
                }
                out.ids.push(lats + "_" + lons)
                out.names.push(nm)
                out.subs.push(sub)
                out.lats.push(lats)
                out.lons.push(lons)
                gi = gi + 1
            }
        }
        out.ok = true
    } catch {
        if out.error == "" { out.error = "geocode transport error" }
    }
    return out
}

// ── PLAN-001：城市列表持久化（local_data_dir JSON 文件）──
// PLAN-009：升格为唯一有序城市表（位置 0=主城市，缺省种子=北京）
fn cities_dir() str {
    return env.local_data_dir() + "/auto-weather"
}

fn cities_path() str {
    return cities_dir() + "/cities.json"
}

// PLAN-009：种子文本（单条北京；首次写操作前的一切读路径回灌此表）
fn seed_cities() str {
    return "{\"cities\":[{\"id\":\"39.90_116.40\",\"name\":\"北京\",\"lat\":\"39.90\",\"lon\":\"116.40\"}]}"
}

// 读-或-种子：文件缺失/解析失败（含 cities 键缺失）→ 种子文本；
// 文件存在且 cities 键在 → 文件文本——空数组「删光」是合法持久态，不回灌种子
fn cities_read_or_seed() str {
    let path str = cities_path()
    if !file.exists(path) {
        return seed_cities()
    }
    let raw str = file.read_text(path)
    if raw == "" {
        return seed_cities()
    }
    let v = json.parse(raw)
    if v == nil {
        return seed_cities()
    }
    let cs = v.cities
    if cs == nil {
        return seed_cities()
    }
    return raw
}

// 读路径（缺失/损坏回灌种子）→ 平行列表；空表（删光）返回 ok:true 空表
fn impl_cities_get() CityListOut {
    var out CityListOut = CityListOut {
        ok: false,
        error: "",
        ids: [],
        names: [],
        lats: [],
        lons: []
    }
    let raw str = cities_read_or_seed()
    let v = json.parse(raw)
    if v == nil {
        out.error = "cities parse failed"
        return out
    }
    let cs = v.cities
    if cs != nil {
        for c in cs {
            out.ids.push("" + c.id)
            out.names.push("" + c.name)
            out.lats.push("" + c.lat)
            out.lons.push("" + c.lon)
        }
    }
    out.ok = true
    return out
}

// 读旧表（缺失/损坏回灌种子）→ 判重 → 追加 → 重写 → 返回新表
// （VG13：数组不出 fn，全就地；PLAN-009：首次添加时北京种子一并落盘）
fn impl_cities_add(id str, name str, lat str, lon str) CityListOut {
    var out CityListOut = CityListOut {
        ok: false,
        error: "",
        ids: [],
        names: [],
        lats: [],
        lons: []
    }
    let path str = cities_path()
    let raw str = cities_read_or_seed()
    let v = json.parse(raw)
    if v != nil {
        let cs = v.cities
        if cs != nil {
            for c in cs {
                let cid str = "" + c.id
                out.ids.push(cid)
                out.names.push("" + c.name)
                out.lats.push("" + c.lat)
                out.lons.push("" + c.lon)
                if cid == id {
                    out.ok = true
                    out.error = ""
                    return out
                }
            }
        }
    }
    out.ids.push(id)
    out.names.push(name)
    out.lats.push(lat)
    out.lons.push(lon)
    var txt str = "{\"cities\":["
    var i int = 0
    while i < out.ids.len() {
        if i != 0 { txt = txt + "," }
        txt = txt + "{\"id\":" + quote_json(out.ids.get(i)) + ",\"name\":" + quote_json(out.names.get(i)) + ",\"lat\":" + quote_json(out.lats.get(i)) + ",\"lon\":" + quote_json(out.lons.get(i)) + "}"
        i = i + 1
    }
    txt = txt + "]}"
    file.create_dir(cities_dir())
    let w int = file.write_text(path, txt)
    if w != 0 {
        out.error = "persist write failed"
        return out
    }
    out.ok = true
    return out
}

// 读旧表 → 过滤 id → 重写 → 返回新表（PLAN-002 T-02）
fn impl_cities_remove(id str) CityListOut {
    var out CityListOut = CityListOut {
        ok: false,
        error: "",
        ids: [],
        names: [],
        lats: [],
        lons: []
    }
    let path str = cities_path()
    if !file.exists(path) {
        out.ok = true
        return out
    }
    let raw str = file.read_text(path)
    if raw == "" {
        out.ok = true
        return out
    }
    let v = json.parse(raw)
    if v != nil {
        let cs = v.cities
        if cs != nil {
            for c in cs {
                let cid str = "" + c.id
                if cid != id {
                    out.ids.push(cid)
                    out.names.push("" + c.name)
                    out.lats.push("" + c.lat)
                    out.lons.push("" + c.lon)
                }
            }
        }
    }
    var txt str = "{\"cities\":["
    var i int = 0
    while i < out.ids.len() {
        if i != 0 { txt = txt + "," }
        txt = txt + "{\"id\":" + quote_json(out.ids.get(i)) + ",\"name\":" + quote_json(out.names.get(i)) + ",\"lat\":" + quote_json(out.lats.get(i)) + ",\"lon\":" + quote_json(out.lons.get(i)) + "}"
        i = i + 1
    }
    txt = txt + "]}"
    let w int = file.write_text(path, txt)
    if w != 0 {
        out.error = "persist write failed"
        return out
    }
    out.ok = true
    return out
}

// ── PLAN-006：设置面持久化（settings.json 整对象替换）──
// PLAN-009：契约改 5 字段——删 default_city（内置城轮选随前端下线，
// coords_for 校验随之删除，表本身保留给 weather_report 内置 id 端点），
// 增 startup（main|last，启动落点白名单）/ last_id（最近选中城市 id，自由 str）
fn settings_path() str {
    return cities_dir() + "/settings.json"
}

fn settings_defaults() SettingsOut {
    return SettingsOut {
        ok: true,
        error: "",
        temp_unit: "c",
        wind_unit: "kmh",
        lang: "zh",
        startup: "main",
        last_id: ""
    }
}

// 按名取值：旧 4 字段文件（含 default_city）读取不报错，多余字段忽略
fn impl_settings_get() SettingsOut {
    let path str = settings_path()
    if !file.exists(path) {
        return settings_defaults()
    }
    let raw str = file.read_text(path)
    if raw == "" {
        return settings_defaults()
    }
    let v = json.parse(raw)
    if v == nil {
        var o SettingsOut = settings_defaults()
        o.error = "settings parse failed"
        return o
    }
    var out SettingsOut = settings_defaults()
    let tu = v.temp_unit
    if tu != nil {
        out.temp_unit = "" + tu
    }
    let wu = v.wind_unit
    if wu != nil {
        out.wind_unit = "" + wu
    }
    let lg = v.lang
    if lg != nil {
        out.lang = "" + lg
    }
    let su = v.startup
    if su != nil {
        out.startup = "" + su
    }
    let li = v.last_id
    if li != nil {
        out.last_id = "" + li
    }
    return out
}

fn impl_settings_set(temp_unit str, wind_unit str, lang str, startup str, last_id str) SettingsOut {
    var out SettingsOut = SettingsOut {
        ok: false,
        error: "",
        temp_unit: temp_unit,
        wind_unit: wind_unit,
        lang: lang,
        startup: startup,
        last_id: last_id
    }
    if temp_unit != "c" && temp_unit != "f" {
        out.error = "bad temp_unit"
        return out
    }
    if wind_unit != "kmh" && wind_unit != "ms" {
        out.error = "bad wind_unit"
        return out
    }
    if lang != "zh" && lang != "en" {
        out.error = "bad lang"
        return out
    }
    if startup != "main" && startup != "last" {
        out.error = "bad startup"
        return out
    }
    let txt str = "{\"temp_unit\":" + quote_json(temp_unit) + ",\"wind_unit\":" + quote_json(wind_unit) + ",\"lang\":" + quote_json(lang) + ",\"startup\":" + quote_json(startup) + ",\"last_id\":" + quote_json(last_id) + "}"
    file.create_dir(cities_dir())
    let w int = file.write_text(settings_path(), txt)
    if w != 0 {
        out.error = "settings write failed"
        return out
    }
    out.ok = true
    return out
}

// 读-定位-与相邻交换-重写（dir: up=前邻 / down=后邻）
fn impl_cities_move(id str, dir str) CityListOut {
    var out CityListOut = CityListOut {
        ok: false,
        error: "",
        ids: [],
        names: [],
        lats: [],
        lons: []
    }
    let path str = cities_path()
    if !file.exists(path) {
        out.ok = true
        return out
    }
    let raw str = file.read_text(path)
    if raw == "" {
        out.ok = true
        return out
    }
    let v = json.parse(raw)
    if v == nil {
        out.error = "cities parse failed"
        return out
    }
    let cs = v.cities
    if cs == nil {
        out.ok = true
        return out
    }
    // 物化（push-only）→ 定位 → 新列表按交换序 push → 写文件 → get 出响应。
    // 注：list .set / 本地方列表整体赋给响应字段都会在 VM 边界退化成
    // 数值句柄（[1360,1325] 与 [1361,1360] 双实证）——响应一律走
    // impl_cities_get 的 push-only 通道。
    var ids []str = []
    var names []str = []
    var lats []str = []
    var lons []str = []
    for c in cs {
        ids.push("" + c.id)
        names.push("" + c.name)
        lats.push("" + c.lat)
        lons.push("" + c.lon)
    }
    var idx int = -1
    var i int = 0
    while i < ids.len() {
        if ids.get(i) == id {
            idx = i
        }
        i = i + 1
    }
    var ids2 []str = []
    var names2 []str = []
    var lats2 []str = []
    var lons2 []str = []
    var j int = 0
    while j < ids.len() {
        var src int = j
        if dir == "up" && idx > 0 {
            if j == idx - 1 {
                src = idx
            } else if j == idx {
                src = idx - 1
            }
        }
        if dir == "down" && idx >= 0 && idx < ids.len() - 1 {
            if j == idx + 1 {
                src = idx
            } else if j == idx {
                src = idx + 1
            }
        }
        ids2.push("" + ids.get(src))
        names2.push("" + names.get(src))
        lats2.push("" + lats.get(src))
        lons2.push("" + lons.get(src))
        j = j + 1
    }
    var txt str = "{\"cities\":["
    var k int = 0
    while k < ids2.len() {
        if k != 0 { txt = txt + "," }
        txt = txt + "{\"id\":" + quote_json(ids2.get(k)) + ",\"name\":" + quote_json(names2.get(k)) + ",\"lat\":" + quote_json(lats2.get(k)) + ",\"lon\":" + quote_json(lons2.get(k)) + "}"
        k = k + 1
    }
    txt = txt + "]}"
    let w int = file.write_text(path, txt)
    if w != 0 {
        out.error = "persist write failed"
        return out
    }
    return impl_cities_get()
}

/// GET /api/weather/settings — 设置面
#[api(method = "GET", path = "/api/weather/settings")]
pub fn settings_get() SettingsOut {
    return impl_settings_get()
}

/// POST /api/weather/settings — 整对象替换（body: temp_unit/wind_unit/lang/startup/last_id）
#[api(method = "POST", path = "/api/weather/settings")]
pub fn settings_set(temp_unit str, wind_unit str, lang str, startup str, last_id str) SettingsOut {
    return impl_settings_set(temp_unit, wind_unit, lang, startup, last_id)
}

/// POST /api/weather/cities_move — 唯一有序表排序（body: id/dir）
#[api(method = "POST", path = "/api/weather/cities_move")]
pub fn cities_move(id str, dir str) CityListOut {
    return impl_cities_move(id, dir)
}

/// GET /api/weather/search?q=<q>&lang=zh|en — 城市搜索（8 条）
#[api(method = "GET", path = "/api/weather/search")]
pub fn weather_search(q str, lang str) SearchOut {
    return impl_search(q, lang)
}

/// GET /api/weather/cities — 唯一有序城市表（位置 0=主城市，读路径种子回灌）
#[api(method = "GET", path = "/api/weather/cities")]
pub fn cities_get() CityListOut {
    return impl_cities_get()
}

/// POST /api/weather/cities — 添加城市（去重追加，body: id/name/lat/lon）
#[api(method = "POST", path = "/api/weather/cities")]
pub fn cities_add(id str, name str, lat str, lon str) CityListOut {
    return impl_cities_add(id, name, lat, lon)
}

/// DELETE /api/weather/cities?id= — 移除城市（删光=空表合法持久态）
#[api(method = "DELETE", path = "/api/weather/cities")]
pub fn cities_remove(id str) CityListOut {
    return impl_cities_remove(id)
}

/// GET /api/weather/report?city=<id>&ut=&uw=&lang= — 全量天气报告
#[api(method = "GET", path = "/api/weather/report")]
pub fn weather_report(city str, ut str, uw str, lang str) ReportOut {
    return impl_report(city, ut, uw, lang)
}

/// GET /api/weather/report_at?lat=&lon=&ut=&uw=&lang= — 任意坐标天气报告
#[api(method = "GET", path = "/api/weather/report_at")]
pub fn weather_report_at(lat str, lon str, ut str, uw str, lang str) ReportOut {
    return impl_report_ll(lat, lon, ut, uw, lang)
}

fn impl_report(city str, ut str, uw str, lang str) ReportOut {
    let coords str = coords_for(city)
    if coords == "" {
        var o ReportOut = ReportOut {
            ok: false,
            error: "unknown city: " + city,
            source: "Open-Meteo",
            condition: "partly",
            cond_zh: "多云",
            icon: "⛅",
            temp: "23°",
            feels: "25°",
            humidity: "65%",
            wind: "12 km/h",
            wind_dir: "",
            pressure: "1012 hPa",
            visibility: "12 km",
            uv: "中等",
            aqi: "—",
            aqi_level: "—",
            pm25: "—",
            pm10: "—",
            o3: "—",
            updated_at: "--:--",
            hourly: [],
            daily: [],
            indices: [],
            precip: [],
            alert_level: "",
            alert_title: "",
            alert_text: ""
        }
        return o
    }
    let ll = coords.split(",")
    return impl_report_ll(ll[0], ll[1], ut, uw, lang)
}

fn impl_report_ll(lat str, lon str, ut str, uw str, lang str) ReportOut {
    var out ReportOut = ReportOut {
        ok: false,
        error: "unknown error",
        source: "Open-Meteo",
        condition: "partly",
        cond_zh: "多云",
        icon: "⛅",
        temp: "23°",
        feels: "25°",
        humidity: "65%",
        wind: "12 km/h",
        wind_dir: "",
        pressure: "1012 hPa",
        visibility: "12 km",
        uv: "中等",
        aqi: "—",
        aqi_level: "—",
        pm25: "—",
        pm10: "—",
        o3: "—",
        updated_at: "--:--",
        hourly: [],
        daily: [],
        indices: [],
        precip: [],
        alert_level: "",
        alert_title: "",
        alert_text: ""
    }
    // PLAN-007：mock 兜底默认文案按 lang 覆盖（en 默认集；失败时前端可见）
    if lang == "en" {
        out.cond_zh = "Partly Cloudy"
        out.uv = "Moderate"
    }
    // PLAN-002：指数推导用原始值——块级 let 不跨 try 块，函数级 var 提升
    var temp_f float = 0.0
    var feels_f float = 0.0
    var uv_f float = 0.0
    var precip_f float = 0.0
    var rain12h bool = false
    var tmax0 float = 0.0
    var tmin0 float = 0.0
    let url str = "https://api.open-meteo.com/v1/forecast?latitude=" + lat + "&longitude=" + lon + "&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,cloud_cover,pressure_msl,wind_speed_10m,wind_direction_10m,uv_index,visibility&hourly=temperature_2m,weather_code,precipitation,precipitation_probability&daily=weather_code,temperature_2m_max,temperature_2m_min&forecast_days=5&wind_speed_unit=kmh&timezone=auto"
    try {
        let raw str = get_text(url)
        if raw == "" {
            out.error = "forecast request failed"
            return out
        }
        let v = json.parse(raw)
        if v == nil {
            out.error = "forecast parse failed"
            return out
        }
        let cur = v.current
        if cur == nil {
            out.error = "forecast shape: no current"
            return out
        }
        // 点访问取数（方法表不存在于 parse 结果——见头注）
        let wc_f float = cur.weather_code
        out.condition = condition_for((wc_f as int))
        out.cond_zh = cond_zh_for((wc_f as int), lang)
        out.icon = icon_for((wc_f as int))
        // PLAN-002：保留原始 float 供指数推导（赋值到函数级 var）
        temp_f = cur.temperature_2m
        feels_f = cur.apparent_temperature
        uv_f = cur.uv_index
        precip_f = cur.precipitation
        out.temp = temp_s(temp_f, ut)
        out.feels = temp_s(feels_f, ut)
        out.humidity = fmt_i(cur.relative_humidity_2m) + "%"
        let spd int = f2i(cur.wind_speed_10m)
        let deg int = f2i(cur.wind_direction_10m)
        if uw == "ms" {
            let spd_ms float = (cur.wind_speed_10m + 0.0) / 3.6
            out.wind = fmt_i(spd_ms) + " m/s"
        } else {
            out.wind = spd.str() + " km/h"
        }
        out.wind_dir = wind_dir_name(deg, lang)
        out.pressure = fmt_i(cur.pressure_msl) + " hPa"
        let vis_m float = cur.visibility
        let vis_km float = vis_m / 1000.0
        out.visibility = fmt_i(vis_km) + " km"
        out.uv = uv_level(uv_f, lang)
        let ctime str = "" + cur.time
        if ctime.len() >= 16 {
            out.updated_at = ctime.sub(11, 16)
        }

        // ── 24h：平行数组 → 两遍 for-in 预生成真列表，按计数器对齐 ──
        let hv = v.hourly
        if hv != nil {
            var htimes []str = []
            for t in hv.time {
                htimes.push("" + t)
            }
            var htemps []float = []
            for t in hv.temperature_2m {
                htemps.push(t)
            }
            var hcodes []int = []
            for c in hv.weather_code {
                let cf float = c
                hcodes.push((cf as int))
            }
            // PLAN-003：降水两通道——概率 raw 扫描（null 安全），量 for-in
            // 元素面 + raw 段显示面（float→str 面缺失，显示走字符串）
            let pr_prob_segs []str = scan_raw_segments(raw, "\"precipitation_probability\":")
            var pr_probs []int = []
            var pi2 int = 0
            for s in pr_prob_segs {
                pr_probs.push(prob_seg_to_i(pr_prob_segs.get(pi2)))
                pi2 = pi2 + 1
            }
            var pr_ams []float = []
            for a in hv.precipitation {
                pr_ams.push(a)
            }
            let pr_amsegs []str = scan_raw_segments(raw, "\"precipitation\":")
            let cur_hour str = ctime.sub(11, 13)
            var i int = 0
            var started bool = false
            while i < htimes.len() {
                let tt str = htimes.get(i)
                if !started {
                    if tt.sub(11, 13) == cur_hour {
                        started = true
                    } else {
                        i = i + 1
                        continue
                    }
                }
                if out.hourly.len() < 24 {
                    var label str = L("现在", "Now", lang)
                    if out.hourly.len() != 0 { label = tt.sub(11, 16) }
                    if out.hourly.len() < 12 {
                        if is_rain_code(hcodes.get(i)) { rain12h = true }
                    }
                    out.hourly.push(HourPoint {
                        time: label,
                        icon: icon_for(hcodes.get(i)),
                        temp: temp_s(htemps.get(i), ut),
                        now: out.hourly.len() == 0
                    })
                    // PLAN-003：同窗降水点（索引对齐三通道）
                    var pprob int = -1
                    if i < pr_probs.len() {
                        pprob = pr_probs.get(i)
                    }
                    var pamt float = 0.0
                    if i < pr_ams.len() {
                        pamt = pr_ams.get(i)
                    }
                    var pseg str = "0"
                    if i < pr_amsegs.len() {
                        pseg = pr_amsegs.get(i)
                    }
                    var pprob_s str = "—"
                    if pprob >= 0 {
                        pprob_s = pprob.str() + "%"
                    }
                    out.precip.push(PrecipPoint {
                        time: label,
                        prob: pprob_s,
                        amount: pseg + "mm",
                        bar: precip_bar(pprob, pamt)
                    })
                }
                i = i + 1
            }
        }

        // ── 5 日：今天 + 星期 ──
        let dv = v.daily
        if dv != nil {
            var ddays []str = []
            for d in dv.time {
                ddays.push("" + d)
            }
            var dmaxs []float = []
            for t in dv.temperature_2m_max {
                dmaxs.push(t)
            }
            var dmins []float = []
            for t in dv.temperature_2m_min {
                dmins.push(t)
            }
            var dcodes []int = []
            for c in dv.weather_code {
                let cf float = c
                dcodes.push((cf as int))
            }
            var j int = 0
            while j < ddays.len() {
                let ds str = ddays.get(j)
                let dwc int = dcodes.get(j)
                if j == 0 {
                    tmax0 = dmaxs.get(j)
                    tmin0 = dmins.get(j)
                }
                var label str = weekday_zh(ds, lang)
                if j == 0 { label = L("今天", "Today", lang) }
                out.daily.push(DayPoint {
                    day: label,
                    icon: icon_for(dwc),
                    cond: cond_zh_for(dwc, lang),
                    tmin: temp_s(dmins.get(j), ut),
                    tmax: temp_s(dmaxs.get(j), ut)
                })
                j = j + 1
            }
        }
    } catch e {
        out.error = "forecast transport: " + e
        return out
    }

    // ── AQI + 空气组分：独立软失败（air-quality API 挂不影响主报文）──
    var aqi_i int = 0
    try {
        let qa str = get_text("https://air-quality-api.open-meteo.com/v1/air-quality?latitude=" + lat + "&longitude=" + lon + "&current=us_aqi,pm2_5,pm10,ozone")
        if qa != "" {
            let qv = json.parse(qa)
            if qv != nil {
                let qc = qv.current
                if qc != nil {
                    let qa_f float = qc.us_aqi
                    aqi_i = (qa_f as int)
                    out.aqi = aqi_i.str()
                    out.aqi_level = aqi_level(aqi_i, lang)
                    let pm25_f float = qc.pm2_5
                    let pm10_f float = qc.pm10
                    let o3_f float = qc.ozone
                    out.pm25 = fmt_i(pm25_f)
                    out.pm10 = fmt_i(pm10_f)
                    out.o3 = fmt_i(o3_f)
                }
            }
        }
    } catch {
        out.aqi = "—"
        out.aqi_level = "—"
        out.pm25 = "—"
        out.pm10 = "—"
        out.o3 = "—"
        aqi_i = 0
    }

    // ── PLAN-005 QWeather 覆盖层（有 key 时逐段覆盖，失败保 OM 基线）──
    try {
        qw_overlay(out, lat, lon, ut, uw, lang)
    } catch e2 {
        out.error = "overlay: " + e2
    }

    // ── PLAN-002 生活指数（本地推导；调试期 catch 定位）──
    try {
        let n1 str = L("穿衣", "Dressing", lang)
        let l1 str = index_dressing(feels_f, lang)
        let t1 str = L("体感 ", "Feels ", lang) + out.feels
        let n2 str = L("洗车", "Car wash", lang)
        let l2 str = index_carwash(rain12h, precip_f, lang)
        let t2 str = L("未来12小时降水", "Rain in next 12h", lang)
        let n3 str = L("运动", "Sport", lang)
        let l3 str = index_sport(temp_f, aqi_i, precip_f, lang)
        let t3 str = L("温度·空气·降水综合", "Temp-Air-Rain mix", lang)
        let n4 str = L("感冒", "Cold", lang)
        let l4 str = index_cold(tmax0, tmin0, lang)
        let t4 str = L("今日温差与低温", "Daily swing & low temp", lang)
        let n5 str = L("紫外线", "UV", lang)
        let t5 str = L("紫外线指数 ", "UV index ", lang) + fmt_i(uv_f)
        out.indices.push(LifeIndex { name: n1, level: l1, note: t1 })
        out.indices.push(LifeIndex { name: n2, level: l2, note: t2 })
        out.indices.push(LifeIndex { name: n3, level: l3, note: t3 })
        out.indices.push(LifeIndex { name: n4, level: l4, note: t4 })
        out.indices.push(LifeIndex { name: n5, level: out.uv, note: t5 })
    } catch e3 {
        out.pm25 = "IDX[" + e3 + "]"
    }

    out.ok = true
    out.error = ""
    return out
}
